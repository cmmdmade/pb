              "text-align": "right !important"
            },
            ".mb": {
              "@media (max-width: 992px)": {
                "margin-bottom": "2rem"
              }
            },
            "img": {
              "object-fit": "cover"
            },
            ".btn, .btn:hover, .btn:focus, .btn:active": {
              "background": "transparent !important",
              "border": "none !important",
              "color": "white",
              "font-weight": "400",
              "padding": "0",
              "margin": "0"
            },
            ".item-wrapper": {
              "width": "100%"
            },
            ".icon-wrap": {
              "display": "inline-flex",
              "margin-top": "2rem"
            },
            ".card-box": {
              "padding": "3rem 2rem",
              "width": "100%",
              "display": "inline-flex",
              "flex-direction": "column",
              "@media (max-width: 992px)": {
                "padding": "2rem"
              },
              "@media (max-width: 767px)": {
                "padding": "1rem"
              }
            },
            ".mobi-mbri": {
              "color": "black",
              "background": "@card",
              "font-size": "1.2rem !important",
              "transition": "all 0.3s",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "width": "50px",
              "height": "50px",
              "border-radius": "50%",
              "padding-top": "1px",
              "margin-left": "1rem"
            },
            ".card-wrapper": {
              "display": "flex"
            },
            ".wrap": {
              "background": "@cardbg"
            },
            ".card-title": {
              "color": "#ffffff",
              "text-align": "left"
            },
            ".mbr-text, .card-box": {
              "text-align": "center",
              "color": "#ffffff"
            },
            ".mbr-link, .link-wrapper": {
              "color": "#000000",
              "text-align": "left"
            },
            ".mbr-text": {
              "text-align": "left",
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "text-align": "left",
              "color": "#ffffff"
