          "_name": "menu1",
          "_sourceTheme": "ascentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ascentm5 menu menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n\t<mbr-parameters>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n\t\t<input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"1\" max=\"5\" step=\"0.1\" value=\"3.7\" condition=\"showLogo\">\n\t\t<input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\" checked>\n\t\t<input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked>\n\t\t<select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n\t\t\t<option value=\"1\" selected>1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t</select>\n\t\t<input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#000000\" condition=\"showIcons\">\n\t\t<input type=\"checkbox\" title=\"Button\" name=\"showButtons\">\n\t\t<header>Styles</header>\n\t\t<input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\" condition=\"none\">\n\t\t<input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n\t\t<input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n\t\t<input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"transparent\">\n\t\t<input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#ffffff\">\n\t\t<input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#4f6df5\">\n\t</mbr-parameters>\n\n\t<nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"navbar-brand\">\n\t\t\t\t<span mbr-if=\"showLogo\" class=\"navbar-logo\">\n\t\t\t\t\t<a href=\"https://crowdattention.studio\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/cas_v1-96x88.png\" alt=\"Crowd Attention Studio\" mbr-style=\"{'height': logoSize + 'rem'}\">\n\t\t\t\t\t</a>\n\t\t\t\t</span>\n\t\t\t\t<span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-black text-primary\" data-app-selector=\".navbar-caption\" href=\"index.html\" data-app-placeholder=\"Type Text\">Crowd Attention Studio</a></span>\n\t\t\t</div>\n\t\t\t<button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n\t\t\t\t<div class=\"hamburger\">\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t</div>\n\t\t\t</button>\n\t\t\t<div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n\t\t\t\t<ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\">\n\t\t\t\t\t\t<a class=\"nav-link link text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"true\">Overview</a>\n\t\t\t\t\t</li></ul>\n\t\t\t\t<div class=\"icons-menu\" mbr-if=\"showIcons\">\n\t\t\t\t\t\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont socicon-googlemaps socicon\"></span>\n\t\t\t\t\t\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 1\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 2\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont socicon-skype socicon\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" mbr-if=\"iconsAmount > 3\">\n\t\t\t\t\t\t<span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-shopping-cart mobi-mbri\"></span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t<div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\">\n\t\t\t\t\t<a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"> Start Now!</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</nav>\n</section>",
          "_cid": "uE0yJaAzBd",
          "_anchor": "menu1-b8",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "_name": "slider02",
          "_sourceTheme": "immersem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider02 mbr-embla\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showDesc\" title=\"Description\">\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\">\n        <input type=\"color\" name=\"container\" title=\"Container BG\" value=\"#4f6df5\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" name=\"showIcon\" title=\"Icon\">\n        <input type=\"color\" name=\"icon\" title=\"Icon Color\" value=\"#999c9f\" condition=\"showIcon\">\n        <input type=\"checkbox\" name=\"showTags\" title=\"Tags\">\n        <input type=\"color\" name=\"tagsBg\" title=\"Tags BG\" value=\"#ffffff\" condition=\"showTags\">\n        <input type=\"checkbox\" name=\"showName\" title=\"Name\" checked>\n        <input type=\"checkbox\" name=\"showRole\" title=\"Role\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\">\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"2\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#000000\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#dcdde0\" name=\"socBorder\" condition=\"showSocial\" selected>\n        <input type=\"color\" name=\"card\" title=\"Card BG\" value=\"#f7f7f7\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/immersem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"content-wrap\" mbr-if=\"showTitle || showDesc || showButtons\">\n                        <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc\">\n                            Skills and perspectives\n                        </p>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .mbr-section-btn\"><b>Business Acceleration Blueprints</b></h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">Continuously updated, market-responsive whitepapers, strategy guides, and more provide step-by-step roadmaps for scaling your business with the latest industry insights and evolving economic strategies.<br>We go beyond theory—our resources are packed with real-world applications, data-driven tactics, and hands-on strategies to help you pivot, innovate, and dominate in any market condition.</p>\n                        </div>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                Read More\n                            </a>\n                            <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                Start Now\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                        <div class=\"embla__viewport\">\n                            <div class=\"embla__container\">\n                                <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                \n                                            <a href=\"https://community.crowdattention.studio/invitation?code=E7BB3C#email\" target=\"false\"><img src=\"@PROJECT_PATH@/assets/images/maximizing_revenue_during_economic_downturns-1920x1080.png\" alt=\"[BAB] Maximizing Revenue During Economic Downturns\"></a></div>\n                                            <div class=\"item-content\">\n                                                <div class=\"item-desc\" mbr-if=\"showIcon || showTags\">\n                                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\">\n                                                        </span>\n                                                    </div>\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" mbr-if=\"showTags\" data-multiline mbr-article>\n                                                        <li class=\"item-wrap\">Science</li>\n                                                        <li class=\"item-wrap\">Knowledge</li>\n                                                    </ul>\n                                                </div>\n                                                <div class=\"name-wrapper\">\n                                                    <div class=\"name-wrap\">\n                                                        <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-name\" mbr-if=\"showName\"><a href=\"https://community.crowdattention.studio/invitation?code=E7BB3C#email\" class=\"text-primary\"><b>Maximizing Revenue During Economic Downturns: A Strategic Guide for Business Owners</b></a></h4>\n                                                        <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">Your blueprint for thriving in uncertain times. Packed with battle-tested strategies, real-world case studies, and actionable insights, this ebook shows you how to diversify revenue, cut costs smartly, leverage automation, and retain customers—so your business not only survives but grows, even in a recession.\n<br>\n<br>Don’t wait for the economy to dictate your future—take control, adapt, and thrive.</p>\n                                                    </div>\n                                                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                                                        <div class=\"soc-item\">\n                                                            <a href=\"https://mobiri.se/\">\n                                                                    <span mbr-icon class=\"mbr-iconfont\n                                                                     socicon socicon-facebook\"></span>\n                                                            </a>\n                                                        </div>\n                                                        <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                                            <a href=\"https://mobiri.se/\">\n                                                                    <span mbr-icon class=\"mbr-iconfont\n                                                                     socicon socicon-youtube\"></span>\n                                                            </a>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                \n                                \n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                \n                                            <a href=\"index.html\" target=\"false\"><img src=\"@PROJECT_PATH@/assets/images/mbr-6-1920x1280.jpeg\" alt=\"Overview: Crowd Attention Studio\"></a></div>\n                                            <div class=\"item-content\">\n                                                <div class=\"item-desc\" mbr-if=\"showIcon || showTags\">\n                                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\">\n                                                        </span>\n                                                    </div>\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" mbr-if=\"showTags\" data-multiline mbr-article>\n                                                        <li class=\"item-wrap\">Science</li>\n                                                        <li class=\"item-wrap\">Knowledge</li>\n                                                    </ul>\n                                                </div>\n                                                <div class=\"name-wrapper\">\n                                                    <div class=\"name-wrap\">\n                                                        <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-name\" mbr-if=\"showName\"><b>More Blueprints Coming Soon!</b></h4>\n                                                        <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\"></p>\n                                                    </div>\n                                                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                                                        <div class=\"soc-item\">\n                                                            <a href=\"https://mobiri.se/\">\n                                                                    <span mbr-icon class=\"mbr-iconfont\n                                                                     socicon socicon-facebook\"></span>\n                                                            </a>\n                                                        </div>\n                                                        <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                                            <a href=\"https://mobiri.se/\">\n                                                                    <span mbr-icon class=\"mbr-iconfont\n                                                                     socicon socicon-youtube\"></span>\n                                                            </a>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"embla__button embla__button--prev\">\n                            <span class=\"mbr-iconfont mobi-mbri-left mobi-mbri\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                        </button>\n                        <button class=\"embla__button embla__button--next\">\n                            <span class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 30px",
                "@media (max-width: 768px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".content-wrapper": {
              "padding": "60px 60px 40px",
              "background-color": "@container",
              "border-radius": "20px",
              "@media (max-width: 992px)": {
                "padding": "60px 20px 40px"
              },
              ".content-wrap": {
                "padding": "0 86px",
                "@media (max-width: 768px)": {
                  "padding": "0"
                },
                ".mbr-desc": {
                  "margin-bottom": "60px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  }
                },
                ".mbr-section-title": {
                  "margin-bottom": "40px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  }
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "display": "inline-flex",
                    "width": "90%",
                    "margin-bottom": "60px",
                    "@media (max-width: 992px)": {
                      "width": "100%",
                      "margin-bottom": "20px"
                    }
                  }
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "672px",
              "max-width": "672px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "space-between",
                "border-radius": "20px !important",
                "background-color": "@card",
                "overflow": "hidden",
                ".item-wrapper": {
                  ".item-img": {
                    "img": {
                      "height": "340px",
                      "border-radius": "0 !important",
                      "object-fit": "cover",
                      "@media (max-width: 768px)": {
                        "height": "300px"
                      }
                    }
                  },
                  ".item-content": {
                    "padding": "32px",
                    "z-index": "1",
                    "position": "relative",
                    "@media (max-width: 768px)": {
                      "padding": "32px 20px"
                    },
                    ".item-desc": {
                      "margin-bottom": "32px",
                      "display": "flex",
                      "align-items": "center",
                      "justify-content": "space-between",
                      "@media (max-width: 768px)": {
                        "display": "block",
                        "margin-bottom": "20px"
                      },
                      ".icon-wrapper": {
                        "@media (max-width: 768px)": {
                          "margin-bottom": "20px"
                        },
                        ".mbr-iconfont": {
                          "font-size": "54px",
                          "color": "@icon",
                          "margin-right": "32px",
                          "@media (max-width: 768px)": {
                            "margin-right": "0"
                          }
                        }
                      },
                      ".list": {
                        "display": "inline-flex",
                        "justify-content": "flex-end",
                        "flex-wrap": "wrap",
                        "margin": "0",
                        "padding": "0",
                        "list-style-type": "none",
                        "@media (max-width: 768px)": {
                          "justify-content": "flex-start"
                        },
                        ".item-wrap": {
                          "display": "inline-flex",
                          "align-items": "center",
                          "justify-content": "center",
                          "background-color": "@tagsBg",
                          "border-radius": "30px",
                          "margin-right": "10px",
                          "margin-bottom": "5px",
                          "padding": "12px 16px",
                          "&:last-child": {
                            "margin-right": "0"
                          }
                        }
                      }
                    },
                    ".name-wrapper": {
                      "display": "flex",
                      "justify-content": "space-between",
                      "align-items": "flex-end",
                      "@media (max-width: 768px)": {
                        "display": "block"
                      },
                      ".name-wrap": {
                        "@media (max-width: 768px)": {
                          "margin-bottom": "20px"
                        },
                        ".item-name": {
                          "margin-bottom": "8px"
                        },
                        ".item-role": {
                          "margin-bottom": "0"
                        }
                      },
                      ".social-wrapper": {
                        "display": "flex",
                        ".soc-item": {
                          "a": {
                            "display": "block",
                            "&:hover, &:hover": {
                              ".mbr-iconfont": {
                                "border": "1px solid @socColor"
                              }
                            },
                            ".mbr-iconfont": {
                              "display": "flex",
                              "align-items": "center",
                              "justify-content": "center",
                              "width": "54px",
                              "height": "54px",
                              "border-radius": "100%",
                              "border": "1px solid @socBorder",
                              "color": "@socColor",
                              "font-size": "18px",
                              "transition": "all 0.3s ease-in-out",
                              "margin-right": "10px"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "-24px",
              "width": "48px",
              "height": "48px",
              "margin-top": "-1.5rem",
              "font-size": "18px",
              "background-color": "transparent !important",
              "color": "@infoColor !important",
              "border": "2px solid @infoColor !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": ".6 !important",
              "@media (max-width: 768px)": {
                "top": "2.5rem"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "opacity": "1 !important"
              },
              "&.embla__button--prev": {
                "left": "30px"
              },
              "&.embla__button--next": {
                "right": "30px"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding-top": "60px",
                "@media (max-width: 768px)": {
                  "padding-top": "100px"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "visible",
              "width": "100%",
              "margin-right": "1rem",
              "@media (max-width: 767px)": {
                "overflow": "hidden"
              }
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
