          "_name": "article4",
          "_sourceTheme": "snackm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article4\" group=\"Article\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"checkbox\" name=\"reverseContent\" title=\"Reverse\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"8\" value=\"6\" step=\"1\">\n        <header>Column 1</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitleCol1\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showTextCol1\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showListCol1\" checked>\n        <input type=\"checkbox\" title=\"Cards\" name=\"showCards\">\n        <select title=\"Amount\" name=\"cardsCount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <header>Column 2</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitleCol2\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showTextCol2\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showListCol2\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md\">\n                <div class=\"column1\">\n                    <div>\n                        <h3 mbr-text class=\"mbr-section-title-column1 mbr-fonts-style\" data-app-selector=\".mbr-section-title-column1\" mbr-theme-style=\"display-5\" mbr-if=\"showTitleCol1\"><b>PAYMENT INFORMATION</b></h3>\n                        <p class=\"mbr-text-column1 mbr-fonts-style\" data-app-selector=\".mbr-text-column1\" mbr-theme-style=\"display-4\" mbr-if=\"showTextCol1\">Proximity Billboards Markets uses third-party ecommerce platform, STRIPE for collection of service fees and cannot change anything pre-written within the software.\n                        </p>\n                        <ul class=\"list-column1 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list-column1\" data-multiline mbr-article mbr-if=\"showListCol1\">\n                            <li class=\"item-wrap\"><span style=\"font-size: 1rem;\">Once any service fees are collected <b>THERE ARE NO REFUNDS</b>, so plan carefully and accordingly and <b>ALWAYS ASK QUESTIONS IF YOU ARE NOT SURE OF SOMETHING</b>.</span><br></li>\n                        </ul>\n                    </div>\n                    <div class=\"cards-row\" mbr-if=\"showCards\">\n                        <div class=\"card-item\">\n                            <img src=\"@PROJECT_PATH@/assets/images/mbr-104x104.png\" alt=\"Visa Credit Card Logo\">\n                        </div>\n                        <div class=\"card-item\" mbr-if=\"cardsCount > 1\">\n                            <img src=\"@PROJECT_PATH@/assets/images/mastercard2.svg\" alt=\"Mastercard Credit Card Logo\">\n                        </div>\n                        <div class=\"card-item\" mbr-if=\"cardsCount > 2\">\n                            <img src=\"false\" alt=\"ApplePay Logo\">\n                        </div>\n                        <div class=\"card-item\" mbr-if=\"cardsCount > 3\">\n                            <img src=\"false\" alt=\"GooglePay Logo\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <div class=\"column2\">\n                    <h3 mbr-text class=\"mbr-section-title-column2 mbr-fonts-style\" data-app-selector=\".mbr-section-title-column2\" mbr-theme-style=\"display-5\" mbr-if=\"showTitleCol2\"><b>PRICING &amp; SERVICE INFORMATION</b></h3>\n                    <p class=\"mbr-text-column2 mbr-fonts-style\" data-app-selector=\".mbr-text-column2\" mbr-theme-style=\"display-4\" mbr-if=\"showTextCol2\">\n                        All pricing is as advertised per timeframe and per business location for single businesses who have verified Google Business Profiles. <b>Please reach out regarding pricing for multiple business locations.</b><br></p>\n                    <ul class=\"list-column2 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list-column2\" data-multiline mbr-article mbr-if=\"showListCol2\">\n                        <li class=\"item-wrap\">This subscription service can be cancelled at anytime. If you need to return back to this service at a later date, you will need to begin again with any one-time service fees in addition to new quarterly or annual fees available at the time of purchase. <b>All pricing is subject to change without notice.</b></li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
