          "_name": "footer1",
          "_sourceTheme": "ascentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ascentm5 footer1\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Footer\" name=\"showLink\" checked>\n        <input type=\"range\" inline title=\"Icons\" name=\"icons\" min=\"1\" max=\"4\" step=\"1\" value=\"1\" condition=\"showLink\">\n        <header>Color</header>\n        <input type=\"color\" title=\"Icon\" name=\"icon\" value=\"#ffffff\" selected condition=\"showLink\">\n        <input type=\"color\" title=\"Card BG\" name=\"cardbg\" value=\"#2a2c2d\" selected>\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center card-wrapper wrap\">\n\n            <div class=\"card p-0 col-12 col-lg-12\">\n\n                <div class=\" row card-box align-center\">\n                    <div class=\"col-lg-6\">\n\n                        <h2 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\">Our solutions empower individuals, business owners, small businesses and startups to achieve sustainable growth in competitive markets.</h2>\n\n\n                    </div>\n\n\n                    <div class=\"col-lg-6 p-0\">\n                        <div class=\"row\">\n                            <div class=\"col-lg-6 col-md-6\">\n                                <p class=\"mbr-text mb-0 mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-4\"><a href=\"#\" class=\"text-white\">Services</a><br><a href=\"#\" class=\"text-white\">About</a>\n                                    <br><a href=\"#\" class=\"text-white\">Community</a>\n                                    <br><a href=\"#\" class=\"text-white\">Contact</a><br><br><br>\n                                </p>\n\n                            </div>\n\n                            <div class=\"col-lg-6 col-md-6\">\n                                <p class=\"mbr-text mb-0 mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-4\">Buford, Georgia 30519<br><br><br><a href=\"#\" class=\"text-white\">Privacy Policy</a><br><a href=\"#\" class=\"text-white\">Terms and Conditions</a><br><br>©2025 - All Rights Reserved.<br>(Rowdy Independents LLC)<br></p>\n\n                            </div>\n\n                        </div>\n\n\n\n                    </div>\n\n\n                    <div class=\"col-lg-6 col-md-12 align-right\">\n                        <div class=\"link-wrapper\" mbr-if=\"showLink\">\n                            <span mbr-text class=\"mbr-link mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-link, .link-wrapper\"><b>Crowd Attention Studio</b></span>\n\n                            <div class=\"icon-wrap\">\n                                <a href=\"#\"><span mbr-icon mbr-if=\"icons > 0\" class=\"mbr-iconfont mbr-link icon p-0 mbr-iconfont-btn icon54-v1-chat-buble3\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span></a>\n                                <a href=\"#\"><span mbr-icon mbr-if=\"icons > 1\" class=\"mbr-iconfont mbr-link icon p-0 mbr-iconfont-btn socicon-facebook socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span></a>\n                                <a href=\"#\"><span mbr-icon mbr-if=\"icons > 2\" class=\"mbr-iconfont mbr-link icon p-0 mbr-iconfont-btn socicon-linkedin socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span></a>\n                                <a href=\"#\"><span mbr-icon mbr-if=\"icons > 3\" class=\"mbr-iconfont mbr-link icon p-0 mbr-iconfont-btn socicon-twitter socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span></a>\n                            </div>\n\n                        </div>\n                    </div>\n\n\n\n\n\n\n\n\n\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uDRTPgPATt",
          "_anchor": "footer1-9h",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".item-img": {
              "position": "relative",
              "img": {
                "transition": "all 0.2s",
                "object-fit": "cover"
              }
            },
            ".cardbg": {
              "background": "@contentBg",
              "height": "100%",
              "min-height": "160px"
            },
            ".mbr-section-subtitle": {
              "border": "1px solid currentColor",
              "border-radius": "1rem",
              "width": "fit-content",
              "padding": "0.2rem 0.7rem",
              "display": "inline-block"
            },
            ".image-wrapper": {
              "overflow": "hidden"
            },
            ".item1": {
              "margin-bottom": "2rem !important"
            },
            ".item-wrapper": {
              "position": "relative",
              "background": "@cardsBg",
              "border": "3px solid @cardsBg",
              "overflow": "hidden",
              "height": "100%",
              "display": "flex",
              "flex-flow": "column nowrap",
              ".item-footer": {
                "margin-top": "auto"
              }
            },
            ".item-link": {
              "position": "absolute",
              "bottom": "8px",
              "right": "90px",
              "color": "#ffffff"
            },
            ".item1, .item": {
              "transition": "transform 0.3s",
              ".item": {
                "&:hover": {
                  "cursor": "pointer"
                }
              },
              "&:hover": {
                ".link-icon-wrapper span": {
                  "transform": "rotate(-20deg) scale(1.3)"
                }
              },
              "margin-bottom": "2rem"
            },
            ".card2": {
              "@media (max-width: 992px)": {
                "margin-top": "1rem"
              }
            },
            ".link-icon-wrapper": {
              "position": "absolute",
              "right": "-1px",
              "padding": "2px",
              "bottom": "-1px",
              "background": "@cardsBg",
              "width": "68px",
              "height": "68px",
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-end",
              "border-top-left-radius": "50%",
              "border-bottom-right-radius": "2rem",
              "z-index": "3",
              ".icon-wrap": {
                "background": "@iconBg",
                "width": "55px",
                "height": "55px",
                "transition": "all 0.3s",
                "display": "flex",
                "justify-content": "center",
                "align-items": "center",
                "border-radius": "50%",
                "span": {
                  "color": "@iconColor",
                  "font-size": "1.1rem",
                  "transition": "all 0.3s",
                  "display": "block",
                  "padding-top": "1px"
                }
              },
              ".svg1": {
                "position": "absolute",
                "top": "-29px",
                "right": "0px",
                "transform": "rotate(180deg)",
                "width": "30px",
                "path": {
                  "fill": "@cardsBg"
                }
              },
              ".svg2": {
                "position": "absolute",
                "transform": "rotate(180deg)",
                "width": "30px",
                "bottom": "0",
                "left": "-29px",
                "path": {
                  "fill": "@cardsBg"
                }
              }
            },
            ".item-content": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "margin-top": "1rem",
              "padding": "0 1.5rem 2rem",
              "@media (max-width: 767px)": {
                "padding": "0 1rem 1.4rem",
                "margin-top": "1rem"
              },
              "display": "flex",
              "flex-direction": "column",
              "height": "100%"
            },
            "img, .item-img": {
              "width": "100%"
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            "@media (max-width: 767px)": {
              ".item": {
                "margin-bottom": "1rem"
              }
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "left"
            },
            ".item-title": {
              "text-align": "left",
              "color": "#ffffff"
            },
            ".item-subtitle": {
              "text-align": "left",
              "color": "#ffffff"
            },
            ".mbr-section-subtitle, .subtitle-wrap, .mbr-section-btn": {
              "text-align": "left",
              "color": "#ffffff"
            },
            ".mbr-text, .item .mbr-section-btn": {
              "color": "#ffffff",
              "text-align": "left"
            }
          },
          "_name": "contacts2",
          "_sourceTheme": "ascentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ascentm5 contacts2\" group=\"contacts\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showCardSubtitle\" title=\"Subtitle\">\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\">\n        <input type=\"checkbox\" name=\"showLink\" title=\"Link\" checked>\n        <input type=\"color\" name=\"cardsBg\" title=\"Card BG\" value=\"#ffffff\">\n        <input type=\"color\" name=\"contentBg\" title=\"Content BG\" value=\"#4f6df5\">\n        <input type=\"color\" name=\"iconColor\" title=\"Icon Color\" value=\"#ffffff\">\n        <input type=\"color\" name=\"iconBg\" title=\"Icon BG\" value=\"#000000\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 content-head\">\n                <div class=\"mbr-section-head mb-4\" mbr-if=\"showTitle || showSubtitle || showmainButton\">\n                    <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                        <b>Title</b>\n                    </h4>\n\n                </div>\n            </div>\n        </div>\n\n        <div class=\"row\">\n\n\n            <div class=\"col-lg-12 col-md-12\">\n                <div class=\"row h-100\">\n\n                    <div class=\"item features-image h-100 col-12 col-md-12 col-lg-12 active\">\n                        <div class=\"item-wrapper card2 h-100\">\n                            <div class=\"item-img h-100\">\n                                <div class=\"cardbg\">\n\n                                </div>\n\n                                <div class=\"link-icon-wrapper\">\n                                    <svg class=\"svg1\" viewBox=\"0 0 100 100\">\n                                        <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                                    </svg>\n\n                                    <div class=\"icon-wrap\">\n                                        <span mbr-icon class=\"mbr-iconfont mbr-iconfont-btn mobi-mbri-right mobi-mbri\"></span>\n                                    </div>\n\n                                    <svg class=\"svg2\" viewBox=\"0 0 100 100\">\n                                        <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                                    </svg>\n\n                                </div>\n\n                                <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                                    <div class=\"subtitle-wrap mb-3 w-100\">\n                                        <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showCardSubtitle\" data-app-selector=\".mbr-section-subtitle, .subtitle-wrap, .mbr-section-btn\">\n                                            Our\n                                            Services</h5>\n                                    </div>\n                                    <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>Got questions?<br></b></h5>\n\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .item .mbr-section-btn\">\n                                        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse a lacus non\n                                        elit pretium\n                                        tristique. Proin pulvinar placerat mi, sed maximus sapien bibendum eu. Duis vel\n                                        lorem sagittis,\n                                        commodo enim nec, vulputate sapien.&nbsp;</p>\n                                </div>\n                                <h4 class=\"item-link mbr-fonts-style mt-3\" mbr-theme-style=\"display-7\" data-app-selector=\".item-link\" mbr-if=\"showLink\">\n                                    <div><br></div>\n                                    <div>Get in touch</div>\n                                </h4>\n\n                            </div>\n\n\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n\n        </div>\n\n\n\n    </div>\n</section>",
