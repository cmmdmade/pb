          "_name": "footer1",
          "_sourceTheme": "ascentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ascentm5 footer1\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Footer\" name=\"showLink\" checked>\n        <input type=\"range\" inline title=\"Icons\" name=\"icons\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" condition=\"showLink\">\n        <header>Color</header>\n        <input type=\"color\" title=\"Icon\" name=\"icon\" value=\"#ffffff\" selected condition=\"showLink\">\n        <input type=\"color\" title=\"Card BG\" name=\"cardbg\" value=\"#2a2c2d\" selected>\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center card-wrapper wrap\">\n\n            <div class=\"card p-0 col-12 col-lg-12\">\n\n                <div class=\" row card-box align-center\">\n                    <div class=\"col-lg-6\">\n\n                        <h2 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\"><br>Your growth hub partner for scalable, innovative digital solutions. We blend AI innovation with expert digital marketing content strategies, and financial flexibility to empower SMALL BUSINESS.<br><b><br>Elevate your brand to new heights.<br></b></h2>\n\n\n                    </div>\n\n\n                    <div class=\"col-lg-6 p-0\">\n                        <div class=\"row\">\n                            <div class=\"col-lg-6 col-md-6\">\n                                <p class=\"mbr-text mb-0 mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">About<br><a href=\"https://knowledge.crowdattention.studio\" class=\"text-info\">Latest Insights</a><br><br>\n                                </p>\n\n                            </div>\n\n                            <div class=\"col-lg-6 col-md-6\">\n                                <p class=\"mbr-text mb-0 mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\"><a href=\"https://myhub.crowdattention.studio\" target=\"_blank\" class=\"text-info\">Client Login</a><br>Contact<br><br>© 2024 (LLC) All Rights Reserved.</p>\n                                <p class=\"mbr-text mb-0 mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-4\"><a href=\"/index.html\" class=\"text-info\"><b>Crowd Attention Studio</b></a></p>\n\n                            </div>\n\n                        </div>\n\n\n\n                    </div>\n\n\n                    <div class=\"col-lg-6 col-md-12\">\n                        <div class=\"link-wrapper\" mbr-if=\"showLink\">\n                            <span mbr-text class=\"mbr-link mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-link, .link-wrapper\"></span>\n\n                            <div class=\"icon-wrap\">\n                                <a href=\"#\"><span mbr-icon mbr-if=\"icons > 0\" class=\"mbr-iconfont mbr-link icon p-0 mbr-iconfont-btn icon54-v1-chat-bubble5\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span></a>\n                                <span mbr-icon mbr-if=\"icons > 1\" class=\"mbr-iconfont mbr-link icon p-0 mbr-iconfont-btn socicon-googlemaps socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                                <a href=\"#\"><span mbr-icon mbr-if=\"icons > 2\" class=\"mbr-iconfont mbr-link icon p-0 mbr-iconfont-btn socicon-linkedin socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span></a>\n                                <a href=\"#\"><span mbr-icon mbr-if=\"icons > 3\" class=\"mbr-iconfont mbr-link icon p-0 mbr-iconfont-btn socicon-twitter socicon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span></a>\n                            </div>\n\n                        </div>\n                    </div>\n\n\n\n\n\n\n\n\n\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
