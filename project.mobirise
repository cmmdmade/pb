            ".row": {
              "justify-content": "center"
            },
            ".content-wrapper": {
              "border-radius": "40px",
              "background-color": "@card",
              "padding": "110px",
              "@media (max-width: 992px)": {
                "padding": "40px"
              },
              "@media (max-width: 768px)": {
