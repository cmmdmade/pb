              "img": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "border-radius": ".75rem !important",
                "width": "100%",
                "height": "100%",
                "object-fit": "cover"
              },
              ".card-wrap": {
                "position": "relative",
                "z-index": "1",
                "display": "inline-flex",
                "flex-direction": "column",
                "width": "50%",
                "padding": "48px",
                "background-color": "@card",
                "border-radius": ".75rem !important",
                "@media (max-width: 1500px)": {
