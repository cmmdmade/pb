  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Crowd Attention Studio",
        "meta_descr": "Crowd Attention Studio helps individuals, small businesses, and startups crush competitive markets by securing smart funding, strategic growth plans, and the right advocates—so they scale faster and thrive sustainably.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
