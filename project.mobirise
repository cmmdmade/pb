    "page1.html": {
      "settings": {
        "title": "CAS Membership",
        "meta_descr": "Capture and convert leads through location-based digital strategies that engage consumers near your business and extend your reach far beyond.",
        "header_custom": "",
        "footer_custom": "<script src=\"https://app.boei.help/embed/k/54dd9bef-8ac5-4e14-8ea1-7a2edde3618a\" async></script>",
