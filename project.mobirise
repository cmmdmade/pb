    "page1.html": {
      "settings": {
        "title": "CAS Membership",
        "meta_descr": "Capture and convert leads through location-based digital strategies that engage consumers near your business and extend your reach far beyond.",
        "header_custom": "",
        "footer_custom": "<script src=\"https://app.boei.help/embed/k/54dd9bef-8ac5-4e14-8ea1-7a2edde3618a\" async></script>",
        "html_before": "",
        "order": "1"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".row": {
              "align-items": "center"
            },
            ".image-wrapper": {
              "@media (max-width: 991px)": {
                "padding": "1rem"
              },
              "@media (max-width: 767px)": {
                "padding-bottom": "2rem"
              }
            },
            ".text-wrapper": {
              "@media (min-width: 992px)": {
                "& when not (@reverseContent)": {
                  "padding": "0 2rem 0 6.2rem"
                },
                "& when (@reverseContent)": {
                  "padding": "0 6.2rem 0 2rem"
                }
              }
            },
            ".under-image": {
              "width": "100%",
              "height": "30%",
              "text-align": "center",
              "padding": "3rem  1rem",
              "margin-top": "0.65rem",
              "background": "@col"
            },
            ".mbr-section-title": {
              "color": "#4f6df5",
              "text-align": "left"
            },
            ".under-img": {
              "text-align": "center",
              "color": "#f7f5f0",
              "margin": "0 !important"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "left",
              "color": "#8d8d8d"
            },
            ".mbr-text": {
              "line-height": "1.4"
            },
            ".mbr-text when (@showTitle), (@showSubTitle)": {
              "padding-top": "2rem"
            },
