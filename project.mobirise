            ".card-box": {
              "padding": "3rem 2rem",
              "width": "100%",
              "display": "inline-flex",
              "flex-direction": "column",
              "@media (max-width: 992px)": {
                "padding": "2rem"
              },
              "@media (max-width: 767px)": {
                "padding": "1rem"
              }
            },
            ".mobi-mbri": {
              "color": "black",
              "background": "@card",
              "font-size": "1.2rem !important",
              "transition": "all 0.3s",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "width": "50px",
              "height": "50px",
              "border-radius": "50%",
              "padding-top": "1px",
              "margin-left": "1rem"
            },
            ".card-wrapper": {
              "display": "flex"
            },
