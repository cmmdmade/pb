              ".svg2": {
                "position": "absolute",
                "transform": "rotate(180deg)",
                "width": "30px",
                "bottom": "0",
                "left": "-29px",
                "path": {
                  "fill": "@cardsBg"
                }
              }
            },
            ".item-content": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "margin-top": "1rem",
