              "color": "#ffffff",
              "text-align": "left"
            },
            ".mbr-text, .card-box": {
              "text-align": "center",
              "color": "#ffffff"
            },
            ".mbr-link, .link-wrapper": {
              "color": "#000000",
              "text-align": "left"
            },
            ".mbr-text": {
