    "display-video-ads.html": {
      "settings": {
        "title": "DESIGN: Display &amp; Video Ads - Proximity Billboards Markets",
        "meta_descr": "",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "2"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 0.5rem)",
            "padding-bottom": "(@paddingBottom * 0.5rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".item-img": {
              "position": "relative"
            },
            ".button1": {
              "background": "@btn1"
            },
            ".btn-wrap": {
              "padding": "1.5rem 1.5rem",
              "border-radius": "2rem",
              "margin-top": "1rem",
              "margin-right": "1rem",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "@media (max-width: 767px)": {
                "margin-top": "0rem",
                "margin-right": "0rem",
                "width": "100%",
                "padding": "1rem 1rem"
              }
            },
            ".button2": {
              "background": "@btn2",
              "@media (max-width: 767px)": {
                "margin-top": "1rem"
              }
            },
            ".title": {
              "position": "absolute",
              "width": "100%",
              "left": "50%",
              "top": "40%",
              "transform": "translate(-50%, -50%)",
              "@media (max-width: 767px)": {
                "top": "25%"
              }
            },
            ".image-wrapper": {
              "overflow": "hidden",
              "position": "relative",
              "border-radius": "2rem",
              "height": "100%",
              "@media (max-width: 992px)": {
                "min-height": "600px"
              },
              "@media (max-width: 767px)": {
                "min-height": "400px"
              },
              "img": {
                "height": "100%",
                "object-fit": "cover"
              }
            },
            ".item-wrapper": {
              "position": "relative",
              "background": "@cardsBg",
              "height": "100%",
              "display": "flex",
              "flex-flow": "column nowrap",
              "@media (max-width: 767px)": {
                "margin-top": "4rem"
              }
            },
            ".link-icon-wrapper": {
              "position": "absolute",
              "left": "-1px",
              "padding": "0rem",
              "bottom": "-1px",
              "background": "@cardsBg",
              "display": "flex",
              "flex-direction": "row",
              "justify-content": "flex-start",
              "align-items": "flex-start",
              "border-top-right-radius": "2rem",
              "border-bottom-left-radius": "2rem",
              "z-index": "3",
              "@media (max-width: 767px)": {
                "padding": "1rem",
                "flex-direction": "column"
              },
              ".icon-wrap": {
                "width": "50px",
                "height": "50px",
                "transition": "all 0.3s",
                "display": "flex",
                "border": "1px solid currentColor",
                "justify-content": "center",
                "align-items": "center",
                "border-radius": "50%",
                "margin-left": "1rem",
                "&:hover": {
                  "cursor": "pointer",
                  "span": {
                    "transform": "scale(1.4)"
                  }
                },
                "span": {
                  "font-size": "1.1rem",
                  "transition": "all 0.3s",
                  "display": "block",
                  "padding-top": "1px"
                }
              },
              ".svg1": {
                "position": "absolute",
                "top": "-40px",
                "left": "0px",
                "transform": "rotate(-90deg)",
                "width": "40px",
                "path": {
                  "fill": "@cardsBg"
                }
              },
              ".svg2": {
                "position": "absolute",
                "transform": "rotate(-90deg)",
                "width": "40px",
                "bottom": "0",
                "right": "-40px",
                "path": {
                  "fill": "@cardsBg"
                }
              }
            },
            ".icon1": {
              "color": "currentColor",
              "border-color": "currentColor"
            },
            ".icon2": {
              "color": "currentColor",
              "border-color": "currentColor"
            },
            "img, .item-img": {
              "width": "100%"
            },
            ".item-title2, .icon2": {
              "color": "#2a2c2d"
            },
            ".item-title1, .icon1": {
              "color": "#ffffff"
            },
            ".main-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".main-title DIV": {
              "text-align": "center"
            }
          },
          "_name": "header4",
          "_sourceTheme": "ascentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ascentm5 header4\" group=\"Header\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n    <header>Cards</header>\n    <input type=\"color\" name=\"cardsBg\" title=\"Card BG\" value=\"#ffffff\">\n    <input type=\"color\" name=\"btn1\" title=\"Button 1\" value=\"#4f6df5\">\n    <input type=\"checkbox\" title=\"Button 2\" name=\"button2\">\n    <input type=\"color\" name=\"btn2\" title=\"Button 2\" value=\"#bed2f5\" condition=\"button2\">\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" required>\n      <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n  </mbr-parameters>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n    <div class=\"row\">\n      <div class=\"col-12 col-md-12 col-lg-12\">\n        <div class=\"item-wrapper\">\n          <div class=\"item-img\">\n            <div class=\"image-wrapper\">\n              <a href=\"index.html\"><img src=\"@PROJECT_PATH@/assets/images/mbr-808x360.jpg\" alt=\"DESIGN: Display & Video Ads\"></a>\n              <div class=\"title\">\n                <h4 class=\"main-title mbr-fonts-style p-0 m-0\" mbr-theme-style=\"display-1\" data-app-selector=\".main-title\"><b>DESIGN: Display &amp; Video Ads</b></h4>\n              </div>\n            </div>\n            <div class=\"link-icon-wrapper\">\n\n              <svg class=\"svg1\" viewBox=\"0 0 100 100\">\n                <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n              </svg>\n\n              <div class=\"btn-wrap button1 d-flex\">\n                <h5 class=\"item-title1 mbr-fonts-style p-0 m-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title1, .icon1\">Get Started</h5>\n\n                <div class=\"icon-wrap icon1\">\n                  <a href=\"display-video-ads.html#pricing3-2k\"><span mbr-icon class=\"mbr-iconfont icon1 mbr-iconfont-btn mobi-mbri-down mobi-mbri\"></span></a>\n                </div>\n\n              </div>\n\n              <div class=\"btn-wrap button2\" mbr-if=\"button2\">\n                <h5 class=\"item-title2 mbr-fonts-style p-0 m-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title2, .icon2\">Read More</h5>\n\n                <div class=\"icon-wrap icon2\">\n                  <a href=\"#\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-btn icon2 mobi-mbri-down mobi-mbri\"></span></a>\n                </div>\n\n              </div>\n\n              <svg class=\"svg2\" viewBox=\"0 0 100 100\">\n                <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n              </svg>\n\n            </div>\n\n\n\n          </div>\n\n\n        </div>\n      </div>\n\n\n\n\n\n    </div>\n  </div>\n</section>",
          "_cid": "unlbBgilYW",
          "_anchor": "header4-2c",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "display": "flex",
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              ".mbr-overlay": {
                "background-color": "@overlayColor",
                "opacity": "@overlayOpacity"
              }
            },
            "@media (min-width: 768px)": {
              "align-items": "~\"@{verticalAlign}\"",
              ".row": {
                "justify-content": "~\"@{horizontalAlign}\""
              }
            },
            "@media (max-width: 991px) and (min-width: 768px)": {
              ".content-wrap": {
                "min-width": "50%"
              }
            },
            "@media (max-width: 767px)": {
              "-webkit-align-items": "center",
              "align-items": "center",
              ".mbr-row": {
                "-webkit-justify-content": "center",
                "justify-content": "center"
              },
              ".content-wrap": {
                "width": "100%"
              }
            },
            ".mbr-section-title": {
              "text-align": "center",
              "color": "#000000"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "center",
              "color": "#000000"
            }
          },
          "_name": "article6",
          "_sourceTheme": "ascentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ascentm5 article6\" group=\"Article\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n'mbr-parallax-background': bg.parallax}\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n    <input type=\"range\" inline name=\"contentWidth\" title=\"Content Width\" min=\"4\" max=\"12\" step=\"1\" value=\"10\">\n    <header>Show / Hide</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n    <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n    <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n    <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n    <select title=\"Vertical Align\" name=\"verticalAlign\" condition=\"fullScreen\">\n      <option value=\"flex-start\">Top</option>\n      <option value=\"center\" selected>Center</option>\n      <option value=\"flex-end\">Bottom</option>\n    </select>\n    <select title=\"Horizontal Align\" name=\"horizontalAlign\">\n      <option value=\"flex-start\">Left</option>\n      <option value=\"center\" selected>Center</option>\n      <option value=\"flex-end\">Right</option>\n    </select>\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" parallax>\n      <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n    </fieldset>\n\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type!='color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffa600\" condition=\"bg.type!='color' && overlay\">\n    <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"bg.type!='color' && overlay\">\n  </mbr-parameters>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row\">\n      <div class=\"content-wrap col-12 col-md-{{contentWidth}}\">\n        <div class=\"mbr-section-btn mb-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Business Consulting</a></div>\n\n        <h1 class=\"mbr-section-title mbr-fonts-style mbr-white mb-4\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" mbr-if=\"showTitle\"><div><b>Eye-catching image and video ads that scream 'Look at me!' and drive traffic like a boss!</b></div>\n        </h1>\n        <h2 class=\"mbr-section-title mbr-fonts-style mbr-white mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">Subtitle\n        </h2>\n        <p class=\"mbr-fonts-style mbr-text mbr-white mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">By Robert Garcia<br></p>\n\n      </div>\n    </div>\n  </div>\n</section>",
          "_cid": "unlZUIF1su",
          "_anchor": "article6-2p",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "pricing3",
          "_sourceTheme": "talkm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"talkm5 pricing3\" group=\"Pricing\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n  'mbr-fullscreen': fullScreen,\n  'mbr-parallax-background': bg.parallax}\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n    <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n    <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n    <select title=\"Columns\" name=\"columns\">\n      <option value=\"12\">1</option>\n      <option value=\"6\" selected>2</option>\n      <option value=\"4\">3</option>\n      <option value=\"3\">4</option>\n    </select>\n    <header>Image</header>\n    <input type=\"image\" name=\"cardimg\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1-1920x1080.jpg\">\n\n\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" parallax>\n      <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/talkm5/components/_images/background2.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n      <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n    </fieldset>\n    <header condition=\"bg.type === 'video'\">Fallback Image</header>\n    <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/talkm5/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n  </mbr-parameters>\n\n  <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row\">\n      <div class=\"item features-without-image col-12 col-md-12 col-lg-{{columns}}\">\n        <div class=\"card-wrapper image item-wrapper align-left\">\n          <div class=\"card-company-row\">\n            <h4 class=\"card-company-name tag1 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-company-name\">ONE CONCEPT/SET (7)</h4>\n            <h4 class=\"card-company-name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-company-name\">$599</h4>\n          </div>\n\n          <div class=\"content\">\n            <h1 class=\"mbr-section-title mbr-fonts-style \" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Display Ads (web)</b></h1>\n\n\n          </div>\n\n\n\n\n        </div>\n      </div>\n      <div class=\"item features-without-image col-12 col-md-12 col-lg-{{columns}}\">\n        <div class=\"card-wrapper item-wrapper align-left\">\n\n\n          <div class=\"content\">\n\n            <ul mbr-text class=\"mbr-text align-left mbr-fonts-style mb-4\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n              <li>Typically, web banners are priced based on their size, however with this package, you'll <b>receive a set number of banners (.png or .jpg) at a very affordable, fixed rate</b>. Perfect for businesses expanding into digital marketing, seeking new leads, and boosting conversions.&nbsp;This package is also ideal for campaigns that complement your emails, website, and social media efforts.<br><br>The most popular <b>STATIC</b> banner size requests include (or switch out and choose from additional available sizes to meet specific needs):<br>• 728x90 (Leaderboard)<br>• 336x280 (Large Rectangle)<br>• 300 x 50 (Mobile Banner)<br>• <b>300x250 (Medium Rectangle)</b><br>• 160x600 (Wide Skyscraper)<br>• 250x250 (Square)<br>• 468x60 (Banner)<br></li><li><b>Includes:</b><br>• 1 concept revision<br>• 1 specialty lead campaign</li>\n            </ul>\n\n          </div>\n\n          <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-7\"><a class=\"btn btn-primary\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>SCHEDULE&nbsp; COLLAB SESSION</a></div>\n\n\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
