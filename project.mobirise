                "height": "800px",
                "object-fit": "cover",
                "@media (max-width: 767px)": {
                  "height": "400px",
                  "border-radius": "2rem !important"
                }
              },
              "@media (max-width: 767px)": {
                "padding": "0",
                "transform": "translateY(320px)"
              }
            },
            ".row": {
              "justify-content": "space-between",
              "background": "linear-gradient(to top, @primaryColor, @secondaryColor)",
              "border-radius": "4rem",
              "padding": "2rem",
              "padding-top": "450px !important",
              "@media (min-width: 992px)": {
                "padding": "4rem"
              },
              "@media (max-width: 767px)": {
                "padding": "1.5rem 0rem",
                "border-radius": "2rem",
                "padding-top": "330px !important"
              }
            },
            "@media (max-width: 1400px)": {
              ".col-lg-12": {
                "flex": "0 0 auto",
                "width": "100%"
              }
            },
            ".mbr-section-btn, .btn": {
              "width": "100%"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            "@media (max-width: 991px)": {
              ".image-wrapper": {
                "margin-bottom": "1rem"
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#ffffff"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff"
            },
            ".mbr-section-subtitle2": {
              "color": "#ffffff"
            }
          },
          "_name": "header3",
          "_sourceTheme": "gumm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gymm5 header3\" group=\"Header\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"1\" max=\"10\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"1\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Price\" name=\"showTitle2\" checked>\n        <input type=\"checkbox\" title=\"Subtitle 1\" name=\"showsubTitle\">\n        <input type=\"checkbox\" title=\"Subtitle 2\" name=\"showsubTitle2\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/gumm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/gumm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"image-wrapper\">\n            <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/mbr-6-1920x1080.jpeg\" alt=\"Mobirise Website Builder\">\n        </div>\n\n        <div class=\"row\">\n\n            <div class=\"col-12 col-md-12 col-lg-12 col-xl-6\">\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showsubTitle\"><b>\n                        LIMITED OFFER</b></h3>\n                <h1 class=\"mbr-section-title mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Prices start&nbsp;</b><br></h1>\n                <h2 class=\"mbr-section-price mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-price\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle2\"><b>at $25.00</b></h2>\n            </div>\n            <div class=\"col-12 col-md-12 col-lg-12 col-xl-5\">\n\n\n\n\n                <div class=\"align-left\">\n                    <h3 class=\"mbr-section-subtitle2 mbr-fonts-style mb-2\" data-app-selector=\".mbr-section-subtitle2\" mbr-theme-style=\"display-2\" mbr-if=\"showsubTitle2\"><b>Business Acceleration Blueprints</b></h3>\n                    <p class=\"mbr-text align-left mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Continuously updated, market-responsive whitepapers, strategy guides, and more providing step-by-step roadmaps for scaling your business with the latest industry insights and evolving economic strategies.<br>\n                    </p>\n\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div mbr-buttons mbr-theme-style=\"display-5\" class=\"mbr-section-btn align-left mt-5\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-black\" data-app-placeholder=\"Type Text\" href=\"bab.html\">VIEW LIBRARY</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
