              }
            },
            ".image-wrapper": {
              "position": "sticky",
              "top": "32px",
              "@media (max-width: 992px)": {
                "margin-bottom": "32px"
              },
              "img": {
                "height": "90vh",
                "object-fit": "cover",
                "@media (max-width: 992px)": {
                  "height": "400px"
                }
              }
            },
            ".content-wrapper": {
              "padding": "64px",
              "border-radius": "2rem !important",
              "border": "1px solid @border",
              "background-color": "@container",
              "@media (max-width: 992px)": {
                "padding": "24px"
              },
              ".content-wrap": {
                "margin-bottom": "32px",
                ".desc-wrapper": {
                  ".mbr-desc": {
                    "display": "inline-flex",
                    "padding": "2px 10px",
                    "position": "relative",
                    "background-color": "@card",
                    "margin-bottom": "16px",
                    "border-radius": "500px",
                    "border": "1px solid @borderDesc"
                  }
                },
                ".mbr-section-title": {
