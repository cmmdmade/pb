        {
          "_name": "slider02",
          "_sourceTheme": "immersem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"slider02 mbr-embla\"\r\n        group=\"Sliders & Galleries\"\r\n        plugins=\"embla\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked/>\r\n        <input type=\"checkbox\" name=\"showDesc\" title=\"Description\" checked/>\r\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked/>\r\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked/>\r\n        <input type=\"color\" name=\"container\" title=\"Container BG\" value=\"#1e1e1e\"/>\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\r\n        <input\r\n                type=\"range\"\r\n                title=\"Interval\"\r\n                name=\"interval\"\r\n                min=\"1\"\r\n                max=\"10\"\r\n                value=\"5\"\r\n                step=\"1\"\r\n                condition=\"autoplay\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\r\n        <input\r\n                type=\"checkbox\"\r\n                name=\"arrowsMobile\"\r\n                title=\"Mobile Arrows\"\r\n                condition=\"arrows\"\r\n                checked\r\n        />\r\n        <header>Cards</header>\r\n        <input\r\n                type=\"range\"\r\n                name=\"gap\"\r\n                title=\"Gap\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <input type=\"checkbox\" name=\"showIcon\" title=\"Icon\" checked/>\r\n        <input type=\"color\" name=\"icon\" title=\"Icon Color\" value=\"#999c9f\" condition=\"showIcon\"/>\r\n        <input type=\"checkbox\" name=\"showTags\" title=\"Tags\" checked/>\r\n        <input type=\"color\" name=\"tagsBg\" title=\"Tags BG\" value=\"#ffffff\" condition=\"showTags\"/>\r\n        <input type=\"checkbox\" name=\"showName\" title=\"Name\" checked/>\r\n        <input type=\"checkbox\" name=\"showRole\" title=\"Role\" checked/>\r\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked/>\r\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"2\" step=\"1\" value=\"2\"\r\n               condition=\"showSocial\"/>\r\n        <input type=\"color\" title=\"Social Color\" value=\"#000000\" name=\"socColor\" condition=\"showSocial\" selected/>\r\n        <input type=\"color\" title=\"Border Color\" value=\"#dcdde0\" name=\"socBorder\" condition=\"showSocial\" selected/>\r\n        <input type=\"color\" name=\"card\" title=\"Card BG\" value=\"#f3f6f9\"/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected/>\r\n        </fieldset>\r\n        <input\r\n                type=\"checkbox\"\r\n                title=\"Overlay\"\r\n                name=\"overlay\"\r\n                condition=\"bg.type !== 'color'\"\r\n                checked\r\n        />\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.1\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12\">\r\n                <div class=\"content-wrapper\">\r\n                    <div class=\"content-wrap\" mbr-if=\"showTitle || showDesc || showButtons\">\r\n                        <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                           mbr-if=\"showDesc\" data-app-selector=\".mbr-desc\">\r\n                            Skills and perspectives\r\n                        </p>\r\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"\r\n                            data-app-selector=\".mbr-section-title, .mbr-section-btn\">\r\n                            <b>The scientific community is <br> a diverse and dynamic group</b>\r\n                        </h2>\r\n                        <div class=\"text-wrapper\">\r\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                               mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\r\n                                The scientific community thrives on collaboration, curiosity, and the collective effort\r\n                                of individuals with diverse skills and perspectives. Together, they push the boundaries\r\n                                of knowledge, drive innovation, and address some of the most pressing challenges facing\r\n                                humanity.\r\n                            </p>\r\n                        </div>\r\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"\r\n                             data-toolbar=\"-mbrBtnMove\">\r\n                            <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\"\r\n                               data-app-placeholder=\"Type Text\">\r\n                                Read More\r\n                            </a>\r\n                            <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                                Start Now\r\n                            </a>\r\n                        </div>\r\n                    </div>\r\n                    <div\r\n                            class=\"embla\"\r\n                            data-loop=\"{{loop}}\"\r\n                            data-auto-play=\"{{autoplay}}\"\r\n                            data-auto-play-interval=\"{{interval}}\"\r\n                            data-draggable=\"{{draggable}}\"\r\n                            data-skip-snaps=\"true\"\r\n                            data-align=\"center\"\r\n                            data-contain-scroll=\"trimSnaps\"\r\n                    >\r\n                        <div class=\"embla__viewport\">\r\n                            <div class=\"embla__container\">\r\n                                <div class=\"embla__slide slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"slide-content\">\r\n                                        <div class=\"item-wrapper\">\r\n                                            <div class=\"item-img\">\r\n                                                <img src=\"@PROJECT_PATH@/assets/images/image18.webp\"\r\n                                                     alt=\"Mobirise Website Builder\"/>\r\n                                            </div>\r\n                                            <div class=\"item-content\">\r\n                                                <div class=\"item-desc\" mbr-if=\"showIcon || showTags\">\r\n                                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\">\r\n                                                        </span>\r\n                                                    </div>\r\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".list, .item-wrap\" mbr-if=\"showTags\"\r\n                                                        data-multiline mbr-article>\r\n                                                        <li class=\"item-wrap\">Science</li>\r\n                                                        <li class=\"item-wrap\">Knowledge</li>\r\n                                                    </ul>\r\n                                                </div>\r\n                                                <div class=\"name-wrapper\">\r\n                                                    <div class=\"name-wrap\">\r\n                                                        <h4 class=\"item-name mbr-fonts-style\"\r\n                                                            mbr-theme-style=\"display-5\"\r\n                                                            data-app-selector=\".item-name\"\r\n                                                            mbr-if=\"showName\">\r\n                                                            <b>Victor Dalton</b>\r\n                                                        </h4>\r\n                                                        <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                                           mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                            Researcher and Scientist:\r\n                                                            Biologist, Chemist, Physicist\r\n                                                        </p>\r\n                                                    </div>\r\n                                                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\r\n                                                        <div class=\"soc-item\">\r\n                                                            <a href=\"https://mobiri.se/\">\r\n                                                                    <span mbr-icon class=\"mbr-iconfont\r\n                                                                     socicon socicon-facebook\"></span>\r\n                                                            </a>\r\n                                                        </div>\r\n                                                        <div class=\"soc-item\" mbr-if=\"soc > 1\">\r\n                                                            <a href=\"https://mobiri.se/\">\r\n                                                                    <span mbr-icon class=\"mbr-iconfont\r\n                                                                     socicon socicon-youtube\"></span>\r\n                                                            </a>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"embla__slide slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"slide-content\">\r\n                                        <div class=\"item-wrapper\">\r\n                                            <div class=\"item-img\">\r\n                                                <img src=\"@PROJECT_PATH@/assets/images/image16.webp\"\r\n                                                     alt=\"Mobirise Website Builder\"/>\r\n                                            </div>\r\n                                            <div class=\"item-content\">\r\n                                                <div class=\"item-desc\" mbr-if=\"showIcon || showTags\">\r\n                                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\">\r\n                                                        </span>\r\n                                                    </div>\r\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".list, .item-wrap\" mbr-if=\"showTags\"\r\n                                                        data-multiline mbr-article>\r\n                                                        <li class=\"item-wrap\">Science</li>\r\n                                                        <li class=\"item-wrap\">Knowledge</li>\r\n                                                    </ul>\r\n                                                </div>\r\n                                                <div class=\"name-wrapper\">\r\n                                                    <div class=\"name-wrap\">\r\n                                                        <h4 class=\"item-name mbr-fonts-style\"\r\n                                                            mbr-theme-style=\"display-5\"\r\n                                                            data-app-selector=\".item-name\"\r\n                                                            mbr-if=\"showName\">\r\n                                                            <b>Jocelin Haynes</b>\r\n                                                        </h4>\r\n                                                        <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                                           mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                            Academic Professor and Educator\r\n                                                        </p>\r\n                                                    </div>\r\n                                                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\r\n                                                        <div class=\"soc-item\">\r\n                                                            <a href=\"https://mobiri.se/\">\r\n                                                                    <span mbr-icon class=\"mbr-iconfont\r\n                                                                     socicon socicon-facebook\"></span>\r\n                                                            </a>\r\n                                                        </div>\r\n                                                        <div class=\"soc-item\" mbr-if=\"soc > 1\">\r\n                                                            <a href=\"https://mobiri.se/\">\r\n                                                                    <span mbr-icon class=\"mbr-iconfont\r\n                                                                     socicon socicon-youtube\"></span>\r\n                                                            </a>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"embla__slide slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"slide-content\">\r\n                                        <div class=\"item-wrapper\">\r\n                                            <div class=\"item-img\">\r\n                                                <img src=\"@PROJECT_PATH@/assets/images/image15.webp\"\r\n                                                     alt=\"Mobirise Website Builder\"/>\r\n                                            </div>\r\n                                            <div class=\"item-content\">\r\n                                                <div class=\"item-desc\" mbr-if=\"showIcon || showTags\">\r\n                                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\">\r\n                                                        </span>\r\n                                                    </div>\r\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".list, .item-wrap\" mbr-if=\"showTags\"\r\n                                                        data-multiline mbr-article>\r\n                                                        <li class=\"item-wrap\">Science</li>\r\n                                                        <li class=\"item-wrap\">Knowledge</li>\r\n                                                    </ul>\r\n                                                </div>\r\n                                                <div class=\"name-wrapper\">\r\n                                                    <div class=\"name-wrap\">\r\n                                                        <h4 class=\"item-name mbr-fonts-style\"\r\n                                                            mbr-theme-style=\"display-5\"\r\n                                                            data-app-selector=\".item-name\"\r\n                                                            mbr-if=\"showName\">\r\n                                                            <b>Barry Lawson</b>\r\n                                                        </h4>\r\n                                                        <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                                           mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                            Ethicist and Philosopher of Science\r\n                                                        </p>\r\n                                                    </div>\r\n                                                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\r\n                                                        <div class=\"soc-item\">\r\n                                                            <a href=\"https://mobiri.se/\">\r\n                                                                    <span mbr-icon class=\"mbr-iconfont\r\n                                                                     socicon socicon-facebook\"></span>\r\n                                                            </a>\r\n                                                        </div>\r\n                                                        <div class=\"soc-item\" mbr-if=\"soc > 1\">\r\n                                                            <a href=\"https://mobiri.se/\">\r\n                                                                    <span mbr-icon class=\"mbr-iconfont\r\n                                                                     socicon socicon-youtube\"></span>\r\n                                                            </a>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"embla__slide slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"slide-content\">\r\n                                        <div class=\"item-wrapper\">\r\n                                            <div class=\"item-img\">\r\n                                                <img src=\"@PROJECT_PATH@/assets/images/image20.webp\"\r\n                                                     alt=\"Mobirise Website Builder\"/>\r\n                                            </div>\r\n                                            <div class=\"item-content\">\r\n                                                <div class=\"item-desc\" mbr-if=\"showIcon || showTags\">\r\n                                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\">\r\n                                                        </span>\r\n                                                    </div>\r\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                                        data-app-selector=\".list, .item-wrap\" mbr-if=\"showTags\"\r\n                                                        data-multiline mbr-article>\r\n                                                        <li class=\"item-wrap\">Science</li>\r\n                                                        <li class=\"item-wrap\">Knowledge</li>\r\n                                                    </ul>\r\n                                                </div>\r\n                                                <div class=\"name-wrapper\">\r\n                                                    <div class=\"name-wrap\">\r\n                                                        <h4 class=\"item-name mbr-fonts-style\"\r\n                                                            mbr-theme-style=\"display-5\"\r\n                                                            data-app-selector=\".item-name\"\r\n                                                            mbr-if=\"showName\">\r\n                                                            <b>Claire Mccarthy</b>\r\n                                                        </h4>\r\n                                                        <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                                           mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                            Science Advocate: Activist and Advocate\r\n                                                        </p>\r\n                                                    </div>\r\n                                                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\r\n                                                        <div class=\"soc-item\">\r\n                                                            <a href=\"https://mobiri.se/\">\r\n                                                                    <span mbr-icon class=\"mbr-iconfont\r\n                                                                     socicon socicon-facebook\"></span>\r\n                                                            </a>\r\n                                                        </div>\r\n                                                        <div class=\"soc-item\" mbr-if=\"soc > 1\">\r\n                                                            <a href=\"https://mobiri.se/\">\r\n                                                                    <span mbr-icon class=\"mbr-iconfont\r\n                                                                     socicon socicon-youtube\"></span>\r\n                                                            </a>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <button class=\"embla__button embla__button--prev\">\r\n                            <span class=\"mbr-iconfont mobi-mbri-left mobi-mbri\" aria-hidden=\"true\"></span>\r\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\r\n                        </button>\r\n                        <button class=\"embla__button embla__button--next\">\r\n                            <span class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" aria-hidden=\"true\"></span>\r\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\r\n                        </button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 30px",
                "@media (max-width: 768px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".content-wrapper": {
              "padding": "60px 60px 40px",
              "background-color": "@container",
              "border-radius": "20px",
              "@media (max-width: 992px)": {
                "padding": "60px 20px 40px"
              },
              ".content-wrap": {
                "padding": "0 86px",
                "@media (max-width: 768px)": {
                  "padding": "0"
                },
                ".mbr-desc": {
                  "margin-bottom": "60px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  }
                },
                ".mbr-section-title": {
                  "margin-bottom": "40px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  }
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "display": "inline-flex",
                    "width": "40%",
                    "margin-bottom": "60px",
                    "@media (max-width: 992px)": {
                      "width": "100%",
                      "margin-bottom": "20px"
                    }
                  }
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "672px",
              "max-width": "672px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "space-between",
                "border-radius": "20px !important",
                "background-color": "@card",
                "overflow": "hidden",
                ".item-wrapper": {
                  ".item-img": {
                    "img": {
                      "height": "340px",
                      "border-radius": "0 !important",
                      "object-fit": "cover",
                      "@media (max-width: 768px)": {
                        "height": "300px"
                      }
                    }
                  },
                  ".item-content": {
                    "padding": "32px",
                    "z-index": "1",
                    "position": "relative",
                    "@media (max-width: 768px)": {
                      "padding": "32px 20px"
                    },
                    ".item-desc": {
                      "margin-bottom": "32px",
                      "display": "flex",
                      "align-items": "center",
                      "justify-content": "space-between",
                      "@media (max-width: 768px)": {
                        "display": "block",
                        "margin-bottom": "20px"
                      },
                      ".icon-wrapper": {
                        "@media (max-width: 768px)": {
                          "margin-bottom": "20px"
                        },
                        ".mbr-iconfont": {
                          "font-size": "54px",
                          "color": "@icon",
                          "margin-right": "32px",
                          "@media (max-width: 768px)": {
                            "margin-right": "0"
                          }
                        }
                      },
                      ".list": {
                        "display": "inline-flex",
                        "justify-content": "flex-end",
                        "flex-wrap": "wrap",
                        "margin": "0",
                        "padding": "0",
                        "list-style-type": "none",
                        "@media (max-width: 768px)": {
                          "justify-content": "flex-start"
                        },
                        ".item-wrap": {
                          "display": "inline-flex",
                          "align-items": "center",
                          "justify-content": "center",
                          "background-color": "@tagsBg",
                          "border-radius": "30px",
                          "margin-right": "10px",
                          "margin-bottom": "5px",
                          "padding": "12px 16px",
                          "&:last-child": {
                            "margin-right": "0"
                          }
                        }
                      }
                    },
                    ".name-wrapper": {
                      "display": "flex",
                      "justify-content": "space-between",
                      "align-items": "flex-end",
                      "@media (max-width: 768px)": {
                        "display": "block"
                      },
                      ".name-wrap": {
                        "@media (max-width: 768px)": {
                          "margin-bottom": "20px"
                        },
                        ".item-name": {
                          "margin-bottom": "8px"
                        },
                        ".item-role": {
                          "margin-bottom": "0"
                        }
                      },
                      ".social-wrapper": {
                        "display": "flex",
                        ".soc-item": {
                          "a": {
                            "display": "block",
                            "&:hover, &:hover": {
                              ".mbr-iconfont": {
                                "border": "1px solid @socColor"
                              }
                            },
                            ".mbr-iconfont": {
                              "display": "flex",
                              "align-items": "center",
                              "justify-content": "center",
                              "width": "54px",
                              "height": "54px",
                              "border-radius": "100%",
                              "border": "1px solid @socBorder",
                              "color": "@socColor",
                              "font-size": "18px",
                              "transition": "all 0.3s ease-in-out",
                              "margin-right": "10px"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "-24px",
              "width": "48px",
              "height": "48px",
              "margin-top": "-1.5rem",
              "font-size": "18px",
              "background-color": "transparent !important",
              "color": "@infoColor !important",
              "border": "2px solid @infoColor !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": ".6 !important",
              "@media (max-width: 768px)": {
                "top": "2.5rem"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "opacity": "1 !important"
              },
              "&.embla__button--prev": {
                "left": "30px"
              },
              "&.embla__button--next": {
                "right": "30px"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding-top": "60px",
                "@media (max-width: 768px)": {
                  "padding-top": "100px"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "visible",
              "width": "100%",
              "margin-right": "1rem",
              "@media (max-width: 767px)": {
                "overflow": "hidden"
              }
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-desc": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".item-name": {
              "color": "#000000"
            },
            ".item-role": {
              "color": "#000000"
            },
            ".list": {
              "color": "#000000"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "center"
            }
          },
          "_cid": "v3RdeCeuBk",
