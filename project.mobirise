          "_params": {}
        },
        {
          "_name": "article03",
          "_sourceTheme": "smartm5",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 80px",
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 24px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".content-wrapper": {
              "border-radius": "40px",
              "background-color": "@card",
              "padding": "110px",
              "@media (max-width: 992px)": {
                "padding": "40px"
              },
              "@media (max-width: 768px)": {
                "padding": "32px"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              },
              ".mbr-text": {
                "margin": "16px 0 0"
              }
            },
            ".mbr-section-title": {
              "color": "#4f6df5"
            },
            ".mbr-text": {
              "color": "#262642"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article03 smartm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Card BG\" value=\"#F3F4F7\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>Our mission goes beyond visibility, aiming to help clients build valuable digital assets and brand ambassadors who enhance their business and contribute to securing funding for growth.</b></h2>\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Our approach—whether through digital asset development, user-generated content, geo-targeted ads, flexible financing, etc. —supports sustainability and market adaptability. We position businesses for immediate and long-term success, providing the resources, agility, and strategic digital insights needed to seize new opportunities swiftly.<br><br><b>Discover how Crowd Attention Studio can boost your business with digital visibility and financial flexibility, empowering you to grow, sustain, and succeed today and in the future.</b><br></p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "article03-6u",
          "_isUserblock": true,
          "_cid": "uwctSchRL1",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "features02",
          "_sourceTheme": "ridem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features02 ridem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#f3f4f7\" name=\"container\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" value=\"#ffffff\" name=\"icon\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Icon BG\" value=\"#4f6df5\" name=\"iconBg\" condition=\"showIcon\" selected>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showCardDesc\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/ridem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/ridem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-6\">\n                            <div class=\"content-wrap\">\n                                <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc\"><b>THE BLUEPRINT</b></p>\n                                <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Amplify Reputation &amp; Visibility</b></h2>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">We enhance your business's local SEO and Google Business Profile to ensure you're always in front of potential customers. At the same time, we guide you in actively engaging with customer reviews, fostering a culture of trust and increasing customer loyalty. Our strategies boost visibility on search engines, improve your reputation, and build a solid foundation for growth.</p>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/mbr-796x410.jpg\" alt=\"Crowd Attention Studio - Amplify Reputation & Visibility\">\n                            </div>\n                        </div>\n                        <div class=\"item features-without-image col-12 col-lg-4 item-mb\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"card-box\">\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"mbr-iconfont fa-bullhorn fa\"></span>\n                                    </div>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .icon-wrapper\"><b>Content &amp; Promotion</b></h4>\n                                    <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDesc\" data-app-selector=\".item-desc\">\n                                        <b>Powerful Electric Motor</b>\n                                    </p>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">Intent-driven content is at the core of our strategy. From blog posts to promotional campaigns, we ensure your content is optimized for search engines and aligned with customer needs, turning viewers into brand ambassadors.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item features-without-image col-12 col-lg-4 item-mb\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"card-box\">\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"mbr-iconfont icon54-v1-split-call\"></span>\n                                    </div>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .icon-wrapper\"><b>AI Call Management</b></h4>\n                                    <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDesc\" data-app-selector=\".item-desc\">\n                                        <b>Long-lasting Battery</b>\n                                    </p>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">Automated call assistance ensures every customer inquiry is captured, answered, and processed efficiently. Say goodbye to missed leads and hello to 24/7 responsiveness that delights your customers and drives lead conversions.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item features-without-image col-12 col-lg-4 item-mb\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"card-box\">\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-growing-chart mobi-mbri\"></span>\n                                    </div>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .icon-wrapper\"><b>Growth &amp; Funding Solutions</b></h4>\n                                    <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDesc\" data-app-selector=\".item-desc\">\n                                        <b>Intelligent Pedal Assist</b>\n                                    </p>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">Our tailored financing options empower your business to expand, upgrade, and adapt. Whether through revenue-based funding or asset-backed loans, we provide the flexibility to meet your unique financial goals.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
