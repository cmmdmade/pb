          "_name": "form1",
          "_sourceTheme": "ascentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ascentm5 form1\" group=\"Form\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n  'mbr-fullscreen': fullScreen,\n  'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"1\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\">\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n    <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n    <header>Color</header>\n    <input type=\"color\" title=\"Icon BG\" name=\"card\" value=\"#000000\" selected>\n    <input type=\"color\" title=\"Card BG\" name=\"cardbg\" value=\"#4f6df5\" selected>\n\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" parallax>\n      <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n      <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n    </fieldset>\n    <header condition=\"bg.type === 'video'\">Fallback Image</header>\n    <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\">\n  </mbr-parameters>\n\n  <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row justify-content-center\">\n\n      <div class=\"col-lg-4 mb\">\n\n        <div class=\"image-wrapper h-100\">\n          <img class=\"h-100\" src=\"@PROJECT_PATH@/assets/images/mbr-1099x616.jpg\" alt=\"Mobirise Website Builder\">\n        </div>\n\n\n      </div>\n\n      <div class=\"card col-12 col-lg-8\">\n\n        <div class=\"card-box card-wrapper wrap align-left\">\n\n          <h2 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>Stay In The Know</b></h2>\n\n\n\n          <div class=\"form-container\">\n            <div mbr-form class=\"col-12 mbr-form\">\n              <!--Formbuilder Form-->\n              <form action name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler mx-auto\" data-verified>\n                <div class=\"row\">\n                  <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for filling out the\n                    form!</div>\n                  <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some problem!\n                  </div>\n                </div>\n                <div class=\"dragArea row\">\n                  <div class=\"col-lg-12 col-md-12 col-sm-12 form-group\" data-for=\"email\">\n                    <input type=\"email\" name=\"email\" placeholder=\"Your Email Adress\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                  </div>\n                  <div class=\"col-auto w-100 align-right mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"btn btn-black\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(255, 255, 255);\"></span>Subscribe</a></div>\n                </div>\n              </form><!--Formbuilder Form-->\n            </div>\n\n          </div>\n\n\n          <p class=\"mbr-text mt-5 pt-5 mbr-fonts-style\" mbr-if=\"showText\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">- For updates, news, and events.<br></p>\n\n\n\n\n\n\n\n\n\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
          "_cid": "tQnUTDRmeu",
          "_anchor": "form1-n",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
