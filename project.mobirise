          "_name": "header4",
          "_sourceTheme": "ascentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ascentm5 header4\" group=\"Header\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n    <header>Cards</header>\n    <input type=\"color\" name=\"cardsBg\" title=\"Card BG\" value=\"#ffffff\">\n    <input type=\"color\" name=\"btn1\" title=\"Button 1\" value=\"#4f6df5\">\n    <input type=\"checkbox\" title=\"Button 2\" name=\"button2\">\n    <input type=\"color\" name=\"btn2\" title=\"Button 2\" value=\"#bed2f5\" condition=\"button2\">\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" required>\n      <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n  </mbr-parameters>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n    <div class=\"row\">\n      <div class=\"col-12 col-md-12 col-lg-12\">\n        <div class=\"item-wrapper\">\n          <div class=\"item-img\">\n            <div class=\"image-wrapper\">\n              <a href=\"index.html\"><img src=\"@PROJECT_PATH@/assets/images/mbr-5-1920x1280.jpeg\" alt=\"Business Presence Optimization\"></a>\n              <div class=\"title\">\n                <h4 class=\"main-title mbr-fonts-style p-0 m-0\" mbr-theme-style=\"display-1\" data-app-selector=\".main-title\"><b>Business Presence Optimization</b></h4>\n              </div>\n            </div>\n            <div class=\"link-icon-wrapper\">\n\n              <svg class=\"svg1\" viewBox=\"0 0 100 100\">\n                <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n              </svg>\n\n              <div class=\"btn-wrap button1 d-flex\">\n                <h5 class=\"item-title1 mbr-fonts-style p-0 m-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title1, .icon1\">Get Started</h5>\n\n                <div class=\"icon-wrap icon1\">\n                  <a href=\"business-presence-optimization.html#pricing3-2r\"><span mbr-icon class=\"mbr-iconfont icon1 mbr-iconfont-btn mobi-mbri-down mobi-mbri\"></span></a>\n                </div>\n\n              </div>\n\n              <div class=\"btn-wrap button2\" mbr-if=\"button2\">\n                <h5 class=\"item-title2 mbr-fonts-style p-0 m-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title2, .icon2\">Read More</h5>\n\n                <div class=\"icon-wrap icon2\">\n                  <a href=\"#\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-btn icon2 mobi-mbri-down mobi-mbri\"></span></a>\n                </div>\n\n              </div>\n\n              <svg class=\"svg2\" viewBox=\"0 0 100 100\">\n                <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n              </svg>\n\n            </div>\n\n\n\n          </div>\n\n\n        </div>\n      </div>\n\n\n\n\n\n    </div>\n  </div>\n</section>",
