        {
          "_name": "pricing3",
          "_sourceTheme": "talkm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"talkm5 pricing3\" group=\"Pricing\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n  'mbr-fullscreen': fullScreen,\n  'mbr-parallax-background': bg.parallax}\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n    <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n    <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n    <select title=\"Columns\" name=\"columns\">\n      <option value=\"12\">1</option>\n      <option value=\"6\" selected>2</option>\n      <option value=\"4\">3</option>\n      <option value=\"3\">4</option>\n    </select>\n    <header>Image</header>\n    <input type=\"image\" name=\"cardimg\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-6-1920x1280.jpg\">\n\n\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" parallax>\n      <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/talkm5/components/_images/background2.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n      <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n    </fieldset>\n    <header condition=\"bg.type === 'video'\">Fallback Image</header>\n    <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/talkm5/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n  </mbr-parameters>\n\n  <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row\">\n      <div class=\"item features-without-image col-12 col-md-12 col-lg-{{columns}}\">\n        <div class=\"card-wrapper image item-wrapper align-left\">\n          <div class=\"card-company-row\">\n            <h4 class=\"card-company-name tag1 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-company-name\">MONTHLY $$$/mo.</h4>\n            <h4 class=\"card-company-name mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-company-name\">Request Pricing</h4>\n          </div>\n\n          <div class=\"content\">\n            <h1 class=\"mbr-section-title mbr-fonts-style \" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"></h1>\n\n\n          </div>\n\n\n\n\n        </div>\n      </div>\n      <div class=\"item features-without-image col-12 col-md-12 col-lg-{{columns}}\">\n        <div class=\"card-wrapper item-wrapper align-left\">\n\n\n          <div class=\"content\">\n\n            <ul mbr-text class=\"mbr-text align-left mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n              <li><span style=\"font-size: 1.4rem;\">• ONE-TIME SETUP FEE</span></li><li><span style=\"font-size: 1.4rem;\">•&nbsp;</span><a href=\"https://knowledge.proximitybillboards.markets\" class=\"text-info\" style=\"font-size: 1.4rem;\">GBP generative optimization</a><span style=\"font-size: 1.4rem;\"> + metadata updates for claimed GBP</span><br></li>\n              <li>• [5] SGE-optimized posts</li>\n              <li>• Performance reporting / MATCH AND MIRROR competitor analysis</li>\n            <!--  <li>• (1) Paid Web Traffic Retargeting Campaign</li><li>• (1) TBA Campaign</li><li>• [Enhancement Service] Reviews Request Management - Collection management of unlimited reviews from your place of business.</li><li>• [Enhancement Service] Social Media Reviews Showcase - Highlight design-enhanced Google Business Profile reviews to your social media platforms.</li> --></ul>\n\n          </div>\n\n          <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-7\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>CONSULT &amp; SUBSCRIBE</a></div>\n\n\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            "ul": {
              "padding": "0",
              "border-top": "1px solid currentColor"
            },
            ".row": {
              "margin": "0"
            },
            ".item-menu-overlay": {
              "top": "-40px"
            },
            ".mbr-section-title": {
              "margin-top": "15rem",
              "color": "#ffffff"
            },
            ".image": {
              "background-image": "url(@cardimg)",
              "background-size": "cover"
            },
            "li": {
              "list-style-type": "none",
              "border-bottom": "1px solid currentColor",
              "padding": "0.5rem 0"
            },
            ".item": {
              "padding": "0",
              "margin-left": "-1px",
              "margin-bottom": "2rem !important"
            },
            ".tag1": {
              "position": "relative",
              "padding-left": "20px !important",
              "&:before": {
                "content": "''",
                "border-radius": "50%",
                "position": "absolute",
                "left": "8px",
                "top": "50%",
                "transform": "translateY(-50%)",
                "background": "currentColor",
                "width": "8px",
                "height": "8px"
              }
            },
            ".card-wrapper": {
              "border": "1px solid @primaryColor",
              "height": "100%",
              "display": "flex",
              "flex-direction": "column",
              "padding": "2rem",
              "@media (max-width: 767px)": {
                "padding": "1rem"
              }
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-company-row": {
              "display": "flex",
              "margin-bottom": "2rem",
              "flex-direction": "row",
              "justify-content": "space-between",
              "flex-wrap": "wrap",
              "@media (max-width: 767px)": {
                "margin-top": "0.5em"
              },
              ".card-company-name": {
                "white-space": "nowrap",
                "margin-right": "5px",
                "margin-bottom": "5px",
                "&:last-child": {
                  "margin-right": "0"
                }
              }
            },
            ".card-company-name": {
              "text-transform": "uppercase",
              "display": "inline-flex",
              "align-items": "center",
              "border": "solid 1px currentColor",
              "text-align": "left",
              "padding": "3px 8px",
              "margin-bottom": "0",
              "border-radius": "20px",
              "line-height": "1",
              "color": "#ffffff"
            },
            "@media (max-width: 991px)": {
              ".image-wrapper": {
                "margin-bottom": "1rem"
              }
            },
            ".image-wrapper": {
              "@media (max-width: 991px)": {
                "padding": "1rem"
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#221b35",
              "text-align": "left"
            }
          },
          "_cid": "unFPPiK82R",
          "_anchor": "pricing3-2r",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "slider02",
          "_sourceTheme": "resumem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider02 mbr-embla resumem5\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text 1\" name=\"showText_1\">\n        <input type=\"checkbox\" title=\"Text 2\" name=\"showText_2\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"3\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\">\n        <input type=\"color\" title=\"Border Color\" value=\"#333333\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <input type=\"color\" title=\"Border Color 1\" value=\"#0f9d58\" name=\"border_1\" selected>\n        <input type=\"color\" title=\"Border Color 2\" value=\"#4285f4\" name=\"border_2\" selected>\n        <input type=\"color\" title=\"Border Color 3\" value=\"#f4b400\" name=\"border_3\" selected>\n        <input type=\"color\" title=\"Border Color 4\" value=\"#db4437\" name=\"border_4\" selected>\n        <input type=\"color\" title=\"Card BG\" value=\"#ffffff\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/resumem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f0f0f0\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        Graphic design\n                    </h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5\">\n                <div class=\"text-wrapper\" mbr-if=\"showText_1\">\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText_1\">\n                        The stages of graphic design typically encompass a series of steps.\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5\">\n                <div class=\"text-wrapper\" mbr-if=\"showText_2\">\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText_2\">\n                        While the specific stages may vary depending on the designer or project.\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            <div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                                                Briefing and Research\n                                            </h4>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\"><b>Customer Engagement:</b> Over 64% of consumers use Google Business Profiles to find contact information for a local business, making it a critical tool for engaging with potential customers directly through Google Search and Maps.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                                                Briefing and Research\n                                            </h4>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\"><b>Impact on Business Revenue:</b> Businesses that complete their Google Business Profile are 2.7 times more likely to be considered reputable by consumers, which can lead to a significant increase in customer trust and, subsequently, revenue.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                                                Conceptualization\n                                            </h4>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\"><b>Search Visibility:</b> Businesses with a Google Business Profile receive 7 times more clicks than businesses without one, highlighting the importance of having an optimized profile to boost online visibility and attract more customers.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                                                Conceptualization\n                                            </h4>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\"><b>Local Searches:</b> 46% of all Google searches are seeking local information, making a well-optimized Google Business Profile essential for local businesses to capture this traffic.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                                                Conceptualization\n                                            </h4>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\"><b>Actionable Results:</b> 76% of people who search for something nearby on their smartphone visit a related business within a day, highlighting the immediate impact of appearing in local search results through Google Business Profile.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                                                Conceptualization\n                                            </h4>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\"><b>Conversion Rate:</b> Businesses with photos on their Google Business Profile receive 42% more requests for directions and 35% more click-throughs to their websites compared to those without photos.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                                                Conceptualization\n                                            </h4>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\"><b>Reviews Influence:</b> 88% of consumers trust online reviews as much as personal recommendations, and Google Business Profile reviews significantly influence purchasing decisions.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                                                Conceptualization\n                                            </h4>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\"><b>Visibility in Local Pack:</b> Only 44% of local businesses have claimed their Google Business Profile, which means businesses that do so have a significant advantage in appearing in the Google Local Pack—a set of three highlighted businesses at the top of local search results.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                                                Conceptualization\n                                            </h4>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\"><b>Mobile Search Impact:</b> 78% of mobile local searches result in an offline purchase, emphasizing the importance of having a mobile-optimized Google Business Profile.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide features-without-image slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"card-box\">\n                                            <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                                                Conceptualization\n                                            </h4>\n                                            <p class=\"card-text mbr-fonts-style\" data-app-selector=\".card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\"><b>Call-to-Action Engagement:</b> Profiles with a \"Call Now\" button see a 70% increase in direct calls from potential customers, making it a critical feature for driving immediate engagement.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            \n                            \n                            \n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
