      "components": [
        {
          "_name": "aimage2",
          "_sourceTheme": "shopm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"image2 shopm5\" group=\"Image & Video\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Media Width\" name=\"imgWidth\" min=\"4\" max=\"8\" step=\"1\" value=\"6\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"cardReverse\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\">\n        <header>Card</header>\n            <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n            <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n            <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n            <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n            <input type=\"color\" title=\"Card Bg\" name=\"cardBg\" value=\"#4f6df5\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/shopm5/components/_images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#FFFFFF\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-if=\"showMainTitle || showMainSubtitle\">\n            <div class=\"col-12 mbr-section-head\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                    <b>Our advantages</b>\n                </h3>\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-2\" mbr-theme-style=\"display-4\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                    Suspendisse sed nisi lacus sed viverra tellus.\n                </h5>\n            </div>\n        </div>\n        <div class=\"row cards-row align-items-stretch {{contentAlign}}\">\n            <div class=\"col-text col-12 col-lg\" mbr-if=\"showTitle || showSubtitle || showText || showButtons\">\n                <div class=\"item-content\">\n                    <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Hyperlocal Ads | Digital Displays | Smart Passes | AI Agents</b></h5>\n                    <h1 class=\"card-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-1\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                        <b><i>pitchAccelerate</i></b>\n                    </h1>\n                    <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text, .mbr-section-btn\">\n                        <b>Where customer engagement meets innovation.</b><br>\n                        Connect your business faster and smarter through hyperlocal digital ads, smart wallet integrations, dynamic displays, and AI-powered communication tools. From first impression to lasting interaction, we give your message the momentum it needs to move — and convert.\n                    </p>\n                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\">\n                        <a href=\"index.html#afeatures3-90\" class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>Start Your Project Today\n                        </a>\n                    </div>\n                </div>\n            </div>\n\n            <!-- VIDEO COLUMN -->\n            <div class=\"col-img col-12 col-lg-{{imgWidth}}\">\n                <div class=\"item-img\">\n                    <div class=\"mbr-video-wrapper\">\n                        <iframe class=\"mbr-embedded-video\" src=\"https://player.vimeo.com/video/1139408553?badge=0&autopause=0&player_id=0&app_id=58479&autoplay=1&loop=1\" frameborder=\"0\" allow=\"autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" title=\"pitch.accelerate_v1\">\n                        </iframe>\n                    </div>\n                </div>\n            </div>\n            <!-- /VIDEO COLUMN -->\n        </div>\n    </div>\n\n    [JS_CODE_0]\n</section>",
