          "_name": "article6",
          "_sourceTheme": "ascentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ascentm5 article6\" group=\"Article\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n'mbr-parallax-background': bg.parallax}\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n    <input type=\"range\" inline name=\"contentWidth\" title=\"Content Width\" min=\"4\" max=\"12\" step=\"1\" value=\"10\">\n    <header>Show / Hide</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n    <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n    <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n    <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n    <select title=\"Vertical Align\" name=\"verticalAlign\" condition=\"fullScreen\">\n      <option value=\"flex-start\">Top</option>\n      <option value=\"center\" selected>Center</option>\n      <option value=\"flex-end\">Bottom</option>\n    </select>\n    <select title=\"Horizontal Align\" name=\"horizontalAlign\">\n      <option value=\"flex-start\">Left</option>\n      <option value=\"center\" selected>Center</option>\n      <option value=\"flex-end\">Right</option>\n    </select>\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" parallax>\n      <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n    </fieldset>\n\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type!='color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffa600\" condition=\"bg.type!='color' && overlay\">\n    <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"bg.type!='color' && overlay\">\n  </mbr-parameters>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row\">\n      <div class=\"content-wrap col-12 col-md-{{contentWidth}}\">\n        <div class=\"mbr-section-btn mb-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Business Consulting</a></div>\n\n        <h1 class=\"mbr-section-title mbr-fonts-style mbr-white mb-4\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" mbr-if=\"showTitle\"><div><b>Eye-catching image and video ads that scream 'Look at me!' and drive traffic like a boss!</b></div>\n        </h1>\n        <h2 class=\"mbr-section-title mbr-fonts-style mbr-white mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">Subtitle\n        </h2>\n        <p class=\"mbr-fonts-style mbr-text mbr-white mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">By Robert Garcia<br></p>\n\n      </div>\n    </div>\n  </div>\n</section>",
          "_cid": "unU4bNVxkr",
          "_anchor": "article6-4s",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "pricing3",
          "_sourceTheme": "talkm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"talkm5 pricing3\" group=\"Pricing\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n  'mbr-fullscreen': fullScreen,\n  'mbr-parallax-background': bg.parallax}\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n    <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n    <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n    <select title=\"Columns\" name=\"columns\">\n      <option value=\"12\">1</option>\n      <option value=\"6\" selected>2</option>\n      <option value=\"4\">3</option>\n      <option value=\"3\">4</option>\n    </select>\n    <header>Image</header>\n    <input type=\"image\" name=\"cardimg\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1-1920x1080.jpg\">\n\n\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" parallax>\n      <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/talkm5/components/_images/background2.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n      <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n    </fieldset>\n    <header condition=\"bg.type === 'video'\">Fallback Image</header>\n    <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/talkm5/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n  </mbr-parameters>\n\n  <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row\">\n      <div class=\"item features-without-image col-12 col-md-12 col-lg-{{columns}}\">\n        <div class=\"card-wrapper image item-wrapper align-left\">\n          <div class=\"card-company-row\">\n            <h4 class=\"card-company-name tag1 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-company-name\">ONE CONCEPT/SET (5)</h4>\n            <h4 class=\"card-company-name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-company-name\">$299</h4>\n          </div>\n\n          <div class=\"content\">\n            <h1 class=\"mbr-section-title mbr-fonts-style \" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Display Ads (web)</b></h1>\n\n\n          </div>\n\n\n\n\n        </div>\n      </div>\n      <div class=\"item features-without-image col-12 col-md-12 col-lg-{{columns}}\">\n        <div class=\"card-wrapper item-wrapper align-left\">\n\n\n          <div class=\"content\">\n\n            <ul mbr-text class=\"mbr-text align-left mbr-fonts-style mb-4\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n              <li>Typically, web banners are priced based on their size, however with this package, you'll <b>receive a set number of banners (.png or .jpg) at a very affordable, fixed rate</b>. Perfect for businesses expanding into digital marketing, seeking new leads, and boosting conversions.&nbsp;This package is also ideal for campaigns that complement your emails, website, and social media efforts.<br><br>The most popular <b>STATIC</b> banner size requests include (or switch out and choose from additional available sizes to meet specific needs):<br>• 728x90 (Leaderboard)<br>• <b>300x250 (Medium Rectangle)</b><br>• 160x600 (Wide Skyscraper)<br>• 250x250 (Square)<br>• 468x60 (Banner)<br></li><li><b>Includes:</b><br>• 1 concept revision<br>• 1 specialty lead campaign</li>\n            </ul>\n\n          </div>\n\n          <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-7\"><a class=\"btn btn-primary\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>SCHEDULE&nbsp; COLLAB SESSION</a></div>\n\n\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            "ul": {
              "padding": "0",
              "border-top": "1px solid currentColor"
            },
            ".row": {
              "margin": "0"
            },
            ".item-menu-overlay": {
              "top": "-40px"
            },
            ".mbr-section-title": {
              "margin-top": "15rem",
              "color": "#ffffff"
            },
            ".image": {
              "background-image": "url(@cardimg)",
              "background-size": "cover"
            },
            "li": {
              "list-style-type": "none",
              "border-bottom": "1px solid currentColor",
              "padding": "0.5rem 0"
            },
            ".item": {
              "padding": "0",
              "margin-left": "-1px",
              "margin-bottom": "2rem !important"
            },
            ".tag1": {
              "position": "relative",
              "padding-left": "20px !important",
              "&:before": {
                "content": "''",
                "border-radius": "50%",
                "position": "absolute",
                "left": "8px",
                "top": "50%",
                "transform": "translateY(-50%)",
                "background": "currentColor",
                "width": "8px",
                "height": "8px"
              }
            },
            ".card-wrapper": {
              "border": "1px solid @primaryColor",
              "height": "100%",
              "display": "flex",
              "flex-direction": "column",
              "padding": "2rem",
              "@media (max-width: 767px)": {
                "padding": "1rem"
              }
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-company-row": {
              "display": "flex",
              "margin-bottom": "2rem",
              "flex-direction": "row",
              "justify-content": "space-between",
              "flex-wrap": "wrap",
              "@media (max-width: 767px)": {
                "margin-top": "0.5em"
              },
              ".card-company-name": {
                "white-space": "nowrap",
                "margin-right": "5px",
                "margin-bottom": "5px",
                "&:last-child": {
                  "margin-right": "0"
                }
              }
            },
            ".card-company-name": {
              "text-transform": "uppercase",
              "display": "inline-flex",
              "align-items": "center",
              "border": "solid 1px currentColor",
              "text-align": "left",
              "padding": "3px 8px",
              "margin-bottom": "0",
              "border-radius": "20px",
              "line-height": "1",
              "color": "#ffffff"
            },
            "@media (max-width: 991px)": {
              ".image-wrapper": {
                "margin-bottom": "1rem"
              }
            },
            ".image-wrapper": {
              "@media (max-width: 991px)": {
                "padding": "1rem"
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#221b35",
              "text-align": "left"
            }
          },
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "unU4bObzdY",
          "_anchor": "pricing3-4t",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
