        {
          "_name": "apeople2",
          "_sourceTheme": "factm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"people2 factm5\" group=\"People\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mobirise-icons2\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Card</header>\n        <input type=\"range\" inline title=\"Count\" name=\"cardCount\" min=\"1\" max=\"6\" step=\"1\" value=\"3\">\n        <input type=\"color\" title=\"Bg Color\" name=\"bgColor\" value=\"#e2e2e2\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showCardIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#747474\" selected condition=\"showCardIcon\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Image\" name=\"showCardImg\" checked>\n        <input type=\"checkbox\" title=\"Name\" name=\"showCardName\" checked>\n        <input type=\"checkbox\" title=\"Profession\" name=\"showCardProf\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/factm5/components/_images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/factm5/components/_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-fluid':fullWidth, container:fullWidth==false}\">\n        <div class=\"main-container\" mbr-if=\"showTitle || showText\">\n            <h4 class=\"mbr-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-title\">\n                <b>Our clients feedback</b>\n            </h4>\n            <p class=\"mbr-text mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                <a href=\"#\" class=\"text-black\">\n                    Work With Us\n                </a>\n            </p>\n        </div>\n        <div class=\"row card-row {{contentAlign}}\" mbr-if=\"showCardIcon || showCardText || showCardImg || showCardName || showCardProf\">\n            <div class=\"card col-12 col-md-6 col-lg-4\">\n                <div class=\"card-wrap\">\n                    <div class=\"testimonial-wrap\" mbr-if=\"showCardIcon\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                    </div>\n                    <p class=\"card-text mbr-fonts-style align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">\n                        \"Sed felis eget velit aliquet sagittis id\n                        consectetur purus ut. Pretium vulputate sapien nec sagittis aliquam malesuada.\"\n                    </p>\n                    <div class=\"card-name-wrap\" mbr-if=\"showCardImg || showCardName || showCardProf\">\n                        <div class=\"card-name-image-wrap\" mbr-if=\"showCardImg\">\n                            <img src=\"@PROJECT_PATH@/assets/images/people1.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"card-name-text-wrap\" mbr-if=\"showCardName || showCardProf\">\n                            <p class=\"card-name mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardName\" data-app-selector=\".card-name\">\n                                Jacob Smith\n                            </p>\n                            <p class=\"card-prof mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardProf\" data-app-selector=\".card-prof\">\n                                Company Name\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6 col-lg-4\" mbr-if=\"cardCount > 1\">\n                <div class=\"card-wrap\">\n                    <div class=\"testimonial-wrap\" mbr-if=\"showCardIcon\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                    </div>\n                    <p class=\"card-text mbr-fonts-style align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">\n                        \"Sagittis purus sit amet volutpat consequat mauris nunc congue. Sed egestas egestas fringilla\n                        phasellus faucibus. \"\n                    </p>\n                    <div class=\"card-name-wrap\" mbr-if=\"showCardImg || showCardName || showCardProf\">\n                        <div class=\"card-name-image-wrap\" mbr-if=\"showCardImg\">\n                            <img src=\"@PROJECT_PATH@/assets/images/people2.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"card-name-text-wrap\" mbr-if=\"showCardName || showCardProf\">\n                            <p class=\"card-name mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardName\" data-app-selector=\".card-name\">\n                                William Davis\n                            </p>\n                            <p class=\"card-prof mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardProf\" data-app-selector=\".card-prof\">\n                                Company Name\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6 col-lg-4\" mbr-if=\"cardCount > 2\">\n                <div class=\"card-wrap\">\n                    <div class=\"testimonial-wrap\" mbr-if=\"showCardIcon\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                    </div>\n                    <p class=\"card-text mbr-fonts-style align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">\n                        \"Cras fermentum odio eu feugiat pretium. Ut venenatis tellus in metus vulputate eu. Proin sed\n                        libero enim sed faucibus turpis. \"\n                    </p>\n                    <div class=\"card-name-wrap\" mbr-if=\"showCardImg || showCardName || showCardProf\">\n                        <div class=\"card-name-image-wrap\" mbr-if=\"showCardImg\">\n                            <img src=\"@PROJECT_PATH@/assets/images/people3.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"card-name-text-wrap\" mbr-if=\"showCardName || showCardProf\">\n                            <p class=\"card-name mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardName\" data-app-selector=\".card-name\">\n                                Alexander Johnson\n                            </p>\n                            <p class=\"card-prof mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardProf\" data-app-selector=\".card-prof\">\n                                Company Name\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6 col-lg-4\" mbr-if=\"cardCount > 3\">\n                <div class=\"card-wrap\">\n                    <div class=\"testimonial-wrap\" mbr-if=\"showCardIcon\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                    </div>\n                    <p class=\"card-text mbr-fonts-style align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">\n                        \"Sagittis purus sit amet volutpat consequat mauris nunc congue. Sed egestas egestas fringilla\n                        phasellus faucibus. \"\n                    </p>\n                    <div class=\"card-name-wrap\" mbr-if=\"showCardImg || showCardName || showCardProf\">\n                        <div class=\"card-name-image-wrap\" mbr-if=\"showCardImg\">\n                            <img src=\"@PROJECT_PATH@/assets/images/people2.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"card-name-text-wrap\" mbr-if=\"showCardName || showCardProf\">\n                            <p class=\"card-name mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardName\" data-app-selector=\".card-name\">\n                                William Davis\n                            </p>\n                            <p class=\"card-prof mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardProf\" data-app-selector=\".card-prof\">\n                                Company Name\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6 col-lg-4\" mbr-if=\"cardCount > 4\">\n                <div class=\"card-wrap\">\n                    <div class=\"testimonial-wrap\" mbr-if=\"showCardIcon\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                    </div>\n                    <p class=\"card-text mbr-fonts-style align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">\n                        \"Cras fermentum odio eu feugiat pretium. Ut venenatis tellus in metus vulputate eu. Proin sed\n                        libero enim sed faucibus turpis. \"\n                    </p>\n                    <div class=\"card-name-wrap\" mbr-if=\"showCardImg || showCardName || showCardProf\">\n                        <div class=\"card-name-image-wrap\" mbr-if=\"showCardImg\">\n                            <img src=\"@PROJECT_PATH@/assets/images/people3.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"card-name-text-wrap\" mbr-if=\"showCardName || showCardProf\">\n                            <p class=\"card-name mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardName\" data-app-selector=\".card-name\">\n                                Alexander Johnson\n                            </p>\n                            <p class=\"card-prof mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardProf\" data-app-selector=\".card-prof\">\n                                Company Name\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6 col-lg-4\" mbr-if=\"cardCount > 5\">\n                <div class=\"card-wrap\">\n                    <div class=\"testimonial-wrap\" mbr-if=\"showCardIcon\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-star mobi-mbri\"></span>\n                        </div>\n                    </div>\n                    <p class=\"card-text mbr-fonts-style align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">\n                        \"Sagittis purus sit amet volutpat consequat mauris nunc congue. Sed egestas egestas fringilla\n                        phasellus faucibus. \"\n                    </p>\n                    <div class=\"card-name-wrap\" mbr-if=\"showCardImg || showCardName || showCardProf\">\n                        <div class=\"card-name-image-wrap\" mbr-if=\"showCardImg\">\n                            <img src=\"@PROJECT_PATH@/assets/images/people2.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"card-name-text-wrap\" mbr-if=\"showCardName || showCardProf\">\n                            <p class=\"card-name mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardName\" data-app-selector=\".card-name\">\n                                William Davis\n                            </p>\n                            <p class=\"card-prof mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardProf\" data-app-selector=\".card-prof\">\n                                Company Name\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".main-container": {
              "width": "100%",
              "margin-bottom": "80px",
              "@media (max-width: 767px)": {
                "margin-bottom": "70px"
              }
            },
            ".mbr-title": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#000000",
              "margin-top": "30px"
            },
            ".card-row": {
              "display": "flex",
              "align-items": "stretch",
              "row-gap": "20px",
              "@media (min-width: 1200px)": {
                "margin": "0 -20px",
                "row-gap": "40px"
              }
            },
            ".row > [class*=\"col\"]": {
              "@media (min-width: 1200px)": {
                "padding-left": "20px",
                "padding-right": "20px"
              }
            },
            ".card": {
              "border-radius": "0"
            },
            ".card-wrap": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "stretch",
              "width": "100%",
              "height": "100%",
              "min-height": "320px",
              "padding": "40px 37px 30px",
              "background-color": "@bgColor",
              "@media (max-width: 767px)": {
                "min-height": "auto"
              },
