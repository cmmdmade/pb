          "_name": "header5",
          "_sourceTheme": "ascentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ascentm5 header5\" group=\"Header\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n    <header>Cards</header>\n    <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n    <input type=\"checkbox\" name=\"showroundTitle\" title=\"Round Title\" checked>\n    <input type=\"checkbox\" name=\"showsubTitle\" title=\"SubTitle\" checked>\n    <input type=\"color\" name=\"cardsBg\" title=\"Card BG\" value=\"#ffffff\">\n    <input type=\"color\" name=\"iconColor\" title=\"Icon Color\" value=\"#000000\">\n    <input type=\"color\" name=\"iconBg\" title=\"Icon BG\" value=\"#ffffff\">\n    <input type=\"color\" name=\"iconColor2\" title=\"Card Icon Color\" value=\"#ffffff\">\n    <input type=\"color\" name=\"iconBg2\" title=\"Card Icon BG\" value=\"#000000\">\n    <input type=\"color\" name=\"iconBg3\" title=\"Round Card BG\" value=\"#4f6df5\">\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" required>\n      <input type=\"image\" title=\"Image\" value=\"file:///C:/Users/renee/Downloads/Mobirise%20PB%20TRANSFER/Mobirise%20PB%20TRANSFER/assets/images/proximitybillboards.solutions-gmb-overlay-1-1920x1080.png\">\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n  </mbr-parameters>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n    <div class=\"row margin-sm-top\">\n      <div class=\"col-12 col-md-12 col-lg-9\">\n        <div class=\"item-wrapper mb-4\">\n          <div class=\"item-img\">\n            <div class=\"image-wrapper\">\n              <img src=\"@PROJECT_PATH@/assets/images/mbr-1-1920x1280.jpg\" alt=\"Mobirise Website Builder\">\n            </div>\n\n            <div class=\"link-icon-wrapper\">\n\n              <h5 class=\"item-title mbr-fonts-style pb-3\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>Presence Optimization&nbsp;</b><br></h5>\n\n\n              <svg class=\"svg1\" viewBox=\"0 0 100 100\">\n                <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n              </svg>\n\n              <div class=\"icon-wrap\">\n                <a href=\"#\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-btn mobi-mbri-down mobi-mbri\"></span></a>\n              </div>\n\n              <svg class=\"svg2\" viewBox=\"0 0 100 100\">\n                <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n              </svg>\n\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"col-lg-3\">\n        <div class=\"row\">\n          <div class=\" features-image m-auto col-12 col-md-4 col-lg-12\">\n            <div class=\"item-round\">\n              <h5 class=\"item-title3 mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".item-title3\" mbr-if=\"showroundTitle\">\n                <b>96%</b>\n              </h5>\n\n              <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-text, .item .mbr-section-btn\">\n                Successful reviews from businesses\n              </p>\n            </div>\n          </div>\n          <div class=\"item2 features-image col-12 col-md-4 col-lg-12\">\n            <div class=\"item-wrapper\">\n              <div class=\"item-img\">\n                <div class=\"image-wrapper\">\n                  <img src=\"@PROJECT_PATH@/assets/images/mbr-808x539.jpg\" alt=\"Mobirise Website Builder\">\n                </div>\n\n                <div class=\"link-icon-wrapper2\">\n                  <svg class=\"svg3\" viewBox=\"0 0 100 100\">\n                    <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                  </svg>\n\n                  <div class=\"icon-wrap2\">\n                    <a href=\"#\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-btn mobi-mbri-right mobi-mbri\"></span></a>\n                  </div>\n\n                  <svg class=\"svg4\" viewBox=\"0 0 100 100\">\n                    <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                  </svg>\n                </div>\n                <div class=\"item-content2\">\n                  <h5 class=\"item-title2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title2\" mbr-if=\"showsubTitle\"><b>Reviews Management</b></h5>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class=\"item2 features-image m-0 col-12 col-md-4 col-lg-12\">\n            <div class=\"item-wrapper\">\n              <div class=\"item-img\">\n                <div class=\"image-wrapper\">\n                  <img src=\"@PROJECT_PATH@/assets/images/mbr-1-808x539.jpg\" alt=\"Mobirise Website Builder\">\n                </div>\n\n                <div class=\"link-icon-wrapper2\">\n                  <svg class=\"svg3\" viewBox=\"0 0 100 100\">\n                    <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                  </svg>\n\n                  <div class=\"icon-wrap2\">\n                    <a href=\"#\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-btn mobi-mbri-right mobi-mbri\"></span></a>\n                  </div>\n\n                  <svg class=\"svg4\" viewBox=\"0 0 100 100\">\n                    <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                  </svg>\n\n                </div>\n\n                <div class=\"item-content2\">\n                  <h5 class=\"item-title2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title2\" mbr-if=\"showsubTitle\"><b>Lead Campaigns Development</b></h5>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
