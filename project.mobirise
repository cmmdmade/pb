              ".icon-wrap": {
                "width": "50px",
                "height": "50px",
                "transition": "all 0.3s",
                "display": "flex",
                "border": "1px solid currentColor",
                "justify-content": "center",
                "align-items": "center",
                "border-radius": "50%",
