          "_name": "contacts2",
          "_sourceTheme": "ascentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ascentm5 contacts2\" group=\"contacts\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showCardSubtitle\" title=\"Subtitle\">\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\">\n        <input type=\"checkbox\" name=\"showLink\" title=\"Link\" checked>\n        <input type=\"color\" name=\"cardsBg\" title=\"Card BG\" value=\"#ffffff\">\n        <input type=\"color\" name=\"contentBg\" title=\"Content BG\" value=\"#4f6df5\">\n        <input type=\"color\" name=\"iconColor\" title=\"Icon Color\" value=\"#ffffff\">\n        <input type=\"color\" name=\"iconBg\" title=\"Icon BG\" value=\"#000000\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 content-head\">\n                <div class=\"mbr-section-head mb-4\" mbr-if=\"showTitle || showSubtitle || showmainButton\">\n                    <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                        <b>Title</b>\n                    </h4>\n\n                </div>\n            </div>\n        </div>\n\n        <div class=\"row\">\n\n\n            <div class=\"col-lg-12 col-md-12\">\n                <div class=\"row h-100\">\n\n                    <div class=\"item features-image h-100 col-12 col-md-12 col-lg-12 active\">\n                        <div class=\"item-wrapper card2 h-100\">\n                            <div class=\"item-img h-100\">\n                                <div class=\"cardbg\">\n\n                                </div>\n\n                                <div class=\"link-icon-wrapper\">\n                                    <svg class=\"svg1\" viewBox=\"0 0 100 100\">\n                                        <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                                    </svg>\n\n                                    <div class=\"icon-wrap\">\n                                        <span mbr-icon class=\"mbr-iconfont mbr-iconfont-btn mobi-mbri-right mobi-mbri\"></span>\n                                    </div>\n\n                                    <svg class=\"svg2\" viewBox=\"0 0 100 100\">\n                                        <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                                    </svg>\n\n                                </div>\n\n                                <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                                    <div class=\"subtitle-wrap mb-3 w-100\">\n                                        <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showCardSubtitle\" data-app-selector=\".mbr-section-subtitle, .subtitle-wrap, .mbr-section-btn\">\n                                            Our\n                                            Services</h5>\n                                    </div>\n                                    <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>Got questions?<br></b></h5>\n\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .item .mbr-section-btn\">\n                                        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse a lacus non\n                                        elit pretium\n                                        tristique. Proin pulvinar placerat mi, sed maximus sapien bibendum eu. Duis vel\n                                        lorem sagittis,\n                                        commodo enim nec, vulputate sapien.&nbsp;</p>\n                                </div>\n                                <h4 class=\"item-link mbr-fonts-style mt-3\" mbr-theme-style=\"display-7\" data-app-selector=\".item-link\" mbr-if=\"showLink\">\n                                    <div><br></div>\n                                    <div>Get in touch</div>\n                                </h4>\n\n                            </div>\n\n\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n\n        </div>\n\n\n\n    </div>\n</section>",
