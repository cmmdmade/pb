            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "10px 8px"
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "padding": "10px 8px"
              }
            },
            ".row": {
              "border-radius": "25px",
              "background-color": "@container",
              "padding": "40px",
              "margin": "0",
              "overflow": "hidden",
              "@media (max-width: 768px)": {
                "padding": "40px 10px"
              },
              ".card, .item": {
                "padding": "0"
              }
            },
            ".row-main": {
              "padding-top": "100px",
              "@media (max-width: 768px)": {
                "padding-top": "50px"
              },
              "& when (@showText)": {
                "border-radius": "25px 25px 0 0"
              },
              "& when (@showTitle)": {
                "border-radius": "25px 25px 0 0"
              },
              ".mbr-text": {
                "margin-bottom": "0",
                "padding-right": "80px",
                "span": {
                  "opacity": ".5"
                },
                "& when (@reverseContent)": {
                  "padding-right": "0",
                  "padding-left": "80px",
                  "@media (max-width: 992px)": {
                    "padding": "0"
                  }
                },
                "@media (max-width: 992px)": {
                  "padding": "0"
                }
              },
              ".mbr-section-title": {
                "margin": "0",
                "span": {
                  "opacity": ".5"
                }
              }
            },
            ".row-content": {
              "justify-content": "center",
              "padding": "40px 32px 84px",
              "@media (max-width: 768px)": {
                "padding": "40px 2px 34px"
              },
              "& when (@showText)": {
                "border-radius": "0 0 25px 25px"
              },
              "& when (@showTitle)": {
                "border-radius": "0 0 25px 25px"
              },
              ".item": {
                "padding": "0 8px",
                "min-height": "410px",
                "margin-bottom": "16px",
                "@media (max-width: 992px)": {
                  "min-height": "300px"
                },
                "&:nth-child(2n)": {
                  ".item-wrapper .item-img::before": {
                    "background-color": "@card_2"
                  }
                },
                "&:nth-child(5n)": {
                  ".item-wrapper .item-img::before": {
                    "background-color": "@card_3"
                  }
                },
                ".item-wrapper": {
                  "border-radius": "0 !important",
                  "height": "100%",
                  ".item-img": {
                    "position": "relative",
                    "border-radius": "33px !important",
                    "overflow": "hidden",
                    "height": "100%",
                    "img": {
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "border-radius": "0 !important",
                      "object-fit": "cover"
                    },
                    "&::before": {
                      "content": "''",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "background-color": "@card_1",
                      "opacity": ".7",
                      "pointer-events": "none",
                      "z-index": "1"
                    },
                    ".item-content": {
                      "display": "flex",
                      "flex-direction": "column",
                      "justify-content": "space-between",
                      "height": "100%",
                      "position": "relative",
                      "z-index": "1",
                      "padding": "56px 40px 40px",
                      "pointer-events": "none",
                      "@media (max-width: 992px)": {
                        "padding": "30px 15px"
                      },
                      ".card-number": {
                        "width": "100%",
                        "margin-bottom": "0",
                        "pointer-events": "visible"
                      },
                      ".card-desc": {
                        "opacity": ".8",
                        "margin-bottom": "0",
                        "pointer-events": "visible"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#222222"
            },
            ".mbr-text": {
              "color": "#222222"
            },
            ".card-number": {
              "color": "#ffffff"
            },
            ".card-desc": {
              "color": "#ffffff"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features01 trackm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"color\" title=\"Container BG\" value=\"#ffffff\" name=\"container\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Number\" name=\"showNumber\" checked>\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" checked>\n        <input type=\"color\" title=\"Card Overlay 1\" value=\"#222222\" name=\"card_1\" selected>\n        <input type=\"color\" title=\"Card Overlay 2\" value=\"#715EDB\" name=\"card_2\" selected>\n        <input type=\"color\" title=\"Card Overlay 3\" value=\"#4f6df5\" name=\"card_3\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-5.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-5.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row row-main\" mbr-class=\"{'flex-row-reverse' : reverseContent}\" mbr-if=\"showTitle || showText\">\n            <div class=\"col-12 col-lg-4 card\">\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Continuously updated market-responsive whitepapers, strategy guides, etc. providing step-by-step roadmaps for scaling your business with the latest industry insights and evolving economic strategies.</p>\n            </div>\n            <div class=\"col-12 col-lg-8 card\">\n                <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                    Major achievements <br> <span>of the musical band</span>\n                </h2>\n            </div>\n        </div>\n        <div class=\"row row-content\">\n            <div class=\"col-12 col-lg-6 item features-image active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://taylora.com/cc/3igxq-Nsttm\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/maximizing_revenue_during_economic_downturns-1920x1080.png\" alt=\"Digital Strategy Guide\" data-slide-to=\"0\" data-bs-slide-to=\"0\"></a>\n                        <div class=\"item-content\">\n                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-number\" mbr-if=\"showNumber\"><b>Maximizing Revenue During Economic Downturns: A Strategic Guide for Business Owners</b></p>\n                            <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-desc\" mbr-if=\"showDesc\">Your blueprint for thriving in uncertain times. Packed with battle-tested strategies, real-world case studies, and actionable insights, this ebook shows you how to diversify revenue, cut costs smartly, leverage automation, and retain customers—so your business not only survives but grows, even in a recession. <br><br>Don’t wait for the economy to dictate your future—take control, adapt, and thrive.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div><div class=\"col-12 col-lg-4 item features-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mbr-700x392.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                        <div class=\"item-content\">\n                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-number\" mbr-if=\"showNumber\">\n                                &gt;</p>\n                            <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-desc\" mbr-if=\"showDesc\">Coming Soon</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"col-12 col-lg-4 item features-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mbr-27-1920x1280.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                        <div class=\"item-content\">\n                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-number\" mbr-if=\"showNumber\">\n                                &gt;</p>\n                            <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-desc\" mbr-if=\"showDesc\">Coming Soon</p>\n                        </div>\n                    </div>\n                </div>\n            </div><div class=\"col-12 col-lg-6 item features-image\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/image5.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"4\" data-bs-slide-to=\"7\">\n                        <div class=\"item-content\">\n                            <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-number\" mbr-if=\"showNumber\">\n                                &gt;</p>\n                            <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-desc\" mbr-if=\"showDesc\">Coming Soon</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            \n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
