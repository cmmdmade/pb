        {
          "_name": "features01",
          "_sourceTheme": "immersem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"features01 immersem5\"\r\n        group=\"Features\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <header>Cards</header>\r\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" checked/>\r\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\" checked/>\r\n        <input type=\"color\" title=\"Icon Color 1\" value=\"#000000\" name=\"icon_1\" condition=\"showIcon\" selected/>\r\n        <input type=\"color\" title=\"Icon Color 2\" value=\"#ffffff\" name=\"icon_2\" condition=\"showIcon\" selected/>\r\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" checked/>\r\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked/>\r\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\" checked/>\r\n        <input type=\"color\" title=\"Card BG 1\" value=\"#f3f6f9\" name=\"card_1\" selected/>\r\n        <input type=\"color\" title=\"Card BG 2\" value=\"#000000\" name=\"card_2\" selected/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected/>\r\n        </fieldset>\r\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n        <input\r\n                type=\"image\"\r\n                title=\"Fallback Image\"\r\n                value=\"@PROJECT_PATH@/assets/images/background1.webp\"\r\n                name=\"fallBackImage\"\r\n                condition=\"bg.type === 'video'\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\"/>\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.8\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n    </mbr-parameters>\r\n\r\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\r\n    <div\r\n            class=\"mbr-overlay\"\r\n            mbr-if=\"overlay && bg.type !== 'color'\"\r\n            opacity=\"{{overlayOpacity}}\"\r\n            bg-color=\"{{overlayColor}}\"\r\n    ></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"item features-without-image col-12 col-lg-6 item-mb\">\r\n                <div class=\"item-wrapper\">\r\n                    <div class=\"card-box\">\r\n                        <p class=\"card-desc_1 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\"\r\n                           data-app-selector=\".card-desc_1\">\r\n                            Purposes\r\n                        </p>\r\n                        <div class=\"icon-wrapper_1\" mbr-if=\"showIcon\">\r\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-users mobi-mbri\"></span>\r\n                        </div>\r\n                        <div class=\"title-wrapper_1\">\r\n                            <h4 class=\"card-title_1 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"\r\n                                data-app-selector=\".card-title_1, .icon-wrapper_1, .buttons_1, .title-wrapper_1\">\r\n                                <b>Fostering Public Understanding</b>\r\n                            </h4>\r\n                        </div>\r\n                        <div class=\"text-wrapper_1\">\r\n                            <p class=\"card-text_1 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\"\r\n                               data-app-selector=\".card-text_1, .text-wrapper_1\">\r\n                                Science communication aims to make scientific concepts accessible and understandable to\r\n                                the general public.\r\n                            </p>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"mbr-section-btn buttons_1\" mbr-if=\"showButtons\"\r\n                         data-toolbar=\"-mbrBtnMove\" mbr-buttons=\"\" mbr-theme-style=\"display-4\">\r\n                        <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\"\r\n                           data-app-placeholder=\"Type Text\">\r\n                            Read More\r\n                        </a>\r\n                        <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                            Start Now\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"item features-without-image col-12 col-lg-6 item-mb\">\r\n                <div class=\"item-wrapper\">\r\n                    <div class=\"card-box\">\r\n                        <p class=\"card-desc_2 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\"\r\n                           data-app-selector=\".card-desc_2\">\r\n                            Purposes\r\n                        </p>\r\n                        <div class=\"icon-wrapper_2\" mbr-if=\"showIcon\">\r\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-growing-chart mobi-mbri\"></span>\r\n                        </div>\r\n                        <div class=\"title-wrapper_2\">\r\n                            <h4 class=\"card-title_2 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"\r\n                                data-app-selector=\".card-title_2, .icon-wrapper_2, .buttons_2, .title-wrapper_2\">\r\n                                <b>Facilitating Informed Decision-Making</b>\r\n                            </h4>\r\n                        </div>\r\n                        <div class=\"text-wrapper_2\">\r\n                            <p class=\"card-text_2 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\"\r\n                               data-app-selector=\".card-text_2, .text-wrapper_2\">\r\n                                Science communication plays a crucial role in empowering individuals to make informed\r\n                                decisions.\r\n                            </p>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"mbr-section-btn buttons_2\" mbr-if=\"showButtons\"\r\n                         data-toolbar=\"-mbrBtnMove\" mbr-buttons=\"\" mbr-theme-style=\"display-4\">\r\n                        <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\"\r\n                           data-app-placeholder=\"Type Text\">\r\n                            Read More\r\n                        </a>\r\n                        <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                            Start Now\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 30px",
                "@media (max-width: 768px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".item": {
              "margin-top": "32px",
              "&:first-child": {
                "margin-top": "0"
              },
              "&:nth-child(2)": {
                "margin-top": "0",
                "@media (max-width: 992px)": {
                  "margin-top": "32px"
                }
              },
              "&:nth-child(2n)": {
                ".item-wrapper": {
                  "background-color": "@card_2"
                }
              },
              ".item-wrapper": {
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "space-between",
                "padding": "52px 40px",
                "background-color": "@card_1",
                "border-radius": "20px !important",
                "height": "100%",
                "@media (max-width: 992px)": {
                  "padding": "46px 20px"
                },
                ".card-box": {
                  ".card-desc_1, .card-desc_2": {
                    "margin-bottom": "46px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "20px"
                    }
                  },
                  ".icon-wrapper_1, .icon-wrapper_2": {
                    ".mbr-iconfont": {
                      "display": "inline-flex",
                      "font-size": "78px",
                      "margin-bottom": "80px",
                      "color": "@icon_1",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "46px"
                      }
                    }
                  },
                  ".icon-wrapper_2": {
                    ".mbr-iconfont": {
                      "color": "@icon_2"
                    }
                  },
                  ".card-title_1, .card-title_2": {
                    "margin-bottom": "32px"
                  },
                  ".title-wrapper_1": {
                    ".card-title_1": {
                      "display": "inline-flex",
                      "width": "70%",
                      "margin-bottom": "32px",
                      "@media (max-width: 1200px)": {
                        "width": "100%"
                      }
                    }
                  },
                  ".title-wrapper_2": {
                    ".card-title_2": {
                      "display": "inline-flex",
                      "width": "70%",
                      "margin-bottom": "32px",
                      "@media (max-width: 1200px)": {
                        "width": "100%"
                      }
                    }
                  },
                  ".text-wrapper_1": {
                    ".card-text_1": {
                      "display": "inline-flex",
                      "width": "60%",
                      "margin-bottom": "32px",
                      "@media (max-width: 992px)": {
                        "width": "100%"
                      }
                    }
                  },
                  ".text-wrapper_2": {
                    ".card-text_2": {
                      "display": "inline-flex",
                      "width": "50%",
                      "margin-bottom": "32px",
                      "@media (max-width: 992px)": {
                        "width": "100%"
                      }
                    }
                  }
                }
              }
            },
            ".card-desc_1": {
              "color": "#000000",
              "text-align": "center"
            },
            ".card-desc_2": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".card-title_1": {
              "color": "#000000"
            },
            ".card-title_2": {
              "color": "#ffffff"
            },
            ".card-text_1, .text-wrapper_1": {
              "color": "#000000",
              "text-align": "center"
            },
            ".card-text_2, .text-wrapper_2": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".card-title_1, .buttons_1, .icon-wrapper_1, .title-wrapper_1": {
              "text-align": "center"
            },
            ".card-title_2, .buttons_2, .icon-wrapper_2, .title-wrapper_2": {
              "text-align": "center"
            }
          },
          "_cid": "v3Rb1Z2ITC",
