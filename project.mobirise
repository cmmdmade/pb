            ".item-content": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "margin-top": "1rem",
              "padding": "0 1.5rem 2rem",
              "@media (max-width: 767px)": {
                "padding": "0 1rem 1.4rem",
                "margin-top": "1rem"
              },
              "display": "flex",
              "flex-direction": "column",
              "height": "100%"
            },
