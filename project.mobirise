    "privacy.html": {
      "settings": {
        "title": "[privacy] pitchAccelerate | Hyperlocal Ads, Smart Wallet & AI Tech Solutions",
        "meta_descr": "Privacy Policy for pitchAccelerate - Hyperlocal Ads | Digital Displays | Smart Passes | AI Agents",
        "header_custom": "",
        "footer_custom": "",
