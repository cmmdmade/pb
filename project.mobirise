        {
          "_name": "features03",
          "_sourceTheme": "immersem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"features03 immersem5\"\r\n        group=\"Features\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked/>\r\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked/>\r\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked/>\r\n        <input type=\"color\" title=\"Container BG\" value=\"#000000\" name=\"container\" selected/>\r\n        <header>Cards</header>\r\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked/>\r\n        <input type=\"checkbox\" title=\"Name\" name=\"showName\" checked/>\r\n        <input type=\"checkbox\" title=\"Role\" name=\"showRole\" checked/>\r\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked/>\r\n        <input type=\"color\" title=\"Icon Color\" value=\"#000000\" name=\"icon\" condition=\"showIcon\" selected/>\r\n        <input type=\"color\" title=\"Icon BG\" value=\"#ffffff\" name=\"iconBg\" condition=\"showIcon\" selected/>\r\n        <input type=\"color\" title=\"Card Border\" value=\"#ffffff\" name=\"border\" selected/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected/>\r\n        </fieldset>\r\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n        <input\r\n                type=\"image\"\r\n                title=\"Fallback Image\"\r\n                value=\"@PROJECT_PATH@/assets/images/background1.webp\"\r\n                name=\"fallBackImage\"\r\n                condition=\"bg.type === 'video'\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\"/>\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.8\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n    </mbr-parameters>\r\n\r\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\r\n    <div\r\n            class=\"mbr-overlay\"\r\n            mbr-if=\"overlay && bg.type !== 'color'\"\r\n            opacity=\"{{overlayOpacity}}\"\r\n            bg-color=\"{{overlayColor}}\"\r\n    ></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12 item\">\r\n                <div class=\"content-wrapper\">\r\n                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\"\r\n                       data-app-selector=\".mbr-desc\">\r\n                        Scientists\r\n                    </p>\r\n                    <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                        data-app-selector=\".mbr-section-title, .mbr-section-btn\"\r\n                        mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                        <b>Pride of our community</b>\r\n                    </h2>\r\n                </div>\r\n            </div>\r\n            <div class=\"item features-image col-12 col-lg-3\">\r\n                <div class=\"item-wrapper\">\r\n                    <div class=\"item-img\">\r\n                        <img src=\"@PROJECT_PATH@/assets/images/image17.webp\" alt=\"Mobirise\">\r\n                        <div class=\"item-content\">\r\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                data-app-selector=\".card-title, .icon-wrapper\" mbr-if=\"showCardTitle\">\r\n                                Kepler University\r\n                            </h4>\r\n                            <p class=\"card-name mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                data-app-selector=\".card-name\" mbr-if=\"showName\">\r\n                                <b>Dr. Olivia Reynolds</b>\r\n                            </p>\r\n                            <p class=\"card-role mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                               data-app-selector=\".card-role\" mbr-if=\"showRole\">\r\n                                PhD in astrophysics\r\n                            </p>\r\n                            <a href=\"#\" class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-link mobi-mbri\"></span>\r\n                            </a>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"item features-image col-12 col-lg-3\">\r\n                <div class=\"item-wrapper\">\r\n                    <div class=\"item-img\">\r\n                        <img src=\"@PROJECT_PATH@/assets/images/image26.webp\" alt=\"Mobirise\">\r\n                        <div class=\"item-content\">\r\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                                data-app-selector=\".card-title, .icon-wrapper\" mbr-if=\"showCardTitle\">\r\n                                Turing Institute\r\n                            </h4>\r\n                            <p class=\"card-name mbr-fonts-style\" mbr-theme-style=\"display-7\"\r\n                               data-app-selector=\".card-name\" mbr-if=\"showName\">\r\n                                <b>Dr. Ethan Holloway</b>\r\n                            </p>\r\n                            <p class=\"card-role mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                               data-app-selector=\".card-role\" mbr-if=\"showRole\">\r\n                                PhD in bioengineering\r\n                            </p>\r\n                            <a href=\"#\" class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-link mobi-mbri\"></span>\r\n                            </a>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 item\">\r\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"\r\n                     data-toolbar=\"-mbrBtnMove\">\r\n                    <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                        Contacts\r\n                    </a>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 30px",
                "@media (max-width: 768px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".row": {
              "margin": "0",
              "justify-content": "center",
              "padding": "60px",
              "background-color": "@container",
              "border-radius": "20px !important",
              "@media (max-width: 992px)": {
                "padding": "46px 10px 46px"
              }
            },
            ".content-wrapper": {
              ".mbr-desc": {
                "margin-bottom": "32px"
              },
              ".mbr-section-title": {
                "margin-bottom": "32px"
              }
            },
            ".item": {
              "padding": "0 10px",
              "margin-bottom": "20px",
              "&:first-child": {
                "margin-bottom": "0"
              },
              "&:last-child": {
                "margin-bottom": "0"
              },
              ".item-wrapper": {
                ".item-img": {
                  "position": "relative",
                  "display": "flex",
                  "align-items": "flex-end",
                  "min-height": "600px",
                  "padding": "32px 20px",
                  "@media (max-width: 992px)": {
                    "min-height": "400px"
                  },
                  "img": {
                    "position": "absolute",
                    "top": "0",
                    "left": "0",
                    "width": "100%",
                    "height": "100%",
                    "object-fit": "cover",
                    "border-radius": "20px !important"
                  },
                  ".item-content": {
                    "width": "100%",
                    "position": "relative",
                    "z-index": "1",
                    ".card-title": {
                      "margin-bottom": "20px"
                    },
                    ".card-name": {
                      "margin-bottom": "5px"
                    },
                    ".card-role": {
                      "margin-bottom": "0"
                    },
                    ".icon-wrapper": {
                      "display": "block",
                      "margin-top": "20px",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@iconBg",
                          "background-color": "@icon"
                        }
                      },
                      ".mbr-iconfont": {
                        "width": "48px",
                        "height": "48px",
                        "display": "inline-flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "font-size": "18px",
                        "color": "@icon",
                        "background-color": "@iconBg",
                        "border-radius": "100%",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "40px"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-desc": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".card-title": {
              "color": "#ffffff"
            },
            ".card-name": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".card-role": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "center"
            },
            ".card-title, .icon-wrapper": {
              "text-align": "center"
            }
          },
          "_cid": "v3Rb6PhTZ6",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "features03-aa"
        },
        {
          "_name": "video01",
          "_sourceTheme": "immersem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"video01 immersem5\"\r\n        group=\"Image & Video\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked/>\r\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked/>\r\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked/>\r\n        <input type=\"color\" title=\"Container BG\" value=\"#1e1e1e\" name=\"container\" selected/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected/>\r\n        </fieldset>\r\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n        <input\r\n                type=\"image\"\r\n                title=\"Fallback Image\"\r\n                value=\"@PROJECT_PATH@/assets/images/background1.webp\"\r\n                name=\"fallBackImage\"\r\n                condition=\"bg.type === 'video'\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\"/>\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.8\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n    </mbr-parameters>\r\n\r\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\r\n    <div\r\n            class=\"mbr-overlay\"\r\n            mbr-if=\"overlay && bg.type !== 'color'\"\r\n            opacity=\"{{overlayOpacity}}\"\r\n            bg-color=\"{{overlayColor}}\"\r\n    ></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12\">\r\n                <div class=\"content-wrapper\">\r\n                    <div class=\"content-wrap\" mbr-if=\"showDesc || showTitle || showText\">\r\n                        <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\"\r\n                           data-app-selector=\".mbr-desc\">\r\n                            Researches\r\n                        </p>\r\n                        <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                            data-app-selector=\".mbr-section-title, .mbr-section-btn, .items-wrapper\"\r\n                            mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                            <b>Researchers work together</b>\r\n                        </h2>\r\n                        <div class=\"text-wrapper\">\r\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\"\r\n                               data-app-selector=\".mbr-text, .text-wrapper\">\r\n                                Scientists within this community engage in rigorous research, experimentation, and analysis\r\n                                to uncover the mysteries of the universe, tackle complex challenges, and contribute to the\r\n                                collective body of knowledge.\r\n                            </p>\r\n                        </div>\r\n                    </div>\r\n                    <div mbr-video class=\"mbr-figure\">\r\n                        <iframe src=\"https://www.youtube.com/watch?v=-BSQlJxCDcI&loop=1&autoplay=1\"></iframe>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 30px",
                "@media (max-width: 768px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".content-wrapper": {
              "background-color": "@container",
              "border-radius": "20px",
              "overflow": "hidden",
              ".content-wrap": {
                "padding": "60px 60px 100px",
                "@media (max-width: 992px)": {
                  "padding": "46px 20px 46px"
                },
                ".mbr-desc": {
                  "margin-bottom": "32px"
                },
                ".mbr-section-title": {
                  "margin-bottom": "32px"
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "display": "inline-flex",
                    "width": "40%",
                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                }
              }
            },
            ".mbr-figure": {
              "iframe": {
                "border-radius": "0 !important",
                "height": "800px !important",
                "@media (max-width: 992px)": {
                  "height": "400px !important"
                }
              },
              ".app-video-wrapper": {
                "img": {
                  "border-radius": "0 !important",
                  "height": "800px !important",
                  "object-fit": "cover",
                  "@media (max-width: 992px)": {
                    "height": "400px !important"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-desc": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#ffffff",
              "text-align": "center"
            }
          },
          "_cid": "v3RenPyeTl",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "video01-ag"
        },
        {
          "_name": "slider03",
          "_sourceTheme": "immersem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"slider03 mbr-embla\"\r\n        group=\"Sliders & Galleries\"\r\n        plugins=\"embla\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\r\n        <input\r\n                type=\"range\"\r\n                title=\"Interval\"\r\n                name=\"interval\"\r\n                min=\"1\"\r\n                max=\"10\"\r\n                value=\"5\"\r\n                step=\"1\"\r\n                condition=\"autoplay\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\r\n        <input\r\n                type=\"checkbox\"\r\n                name=\"arrowsMobile\"\r\n                title=\"Mobile Arrows\"\r\n                condition=\"arrows\"\r\n        />\r\n        <header>Cards</header>\r\n        <input type=\"checkbox\" name=\"showDesc\" title=\"Card Description\" checked/>\r\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Card Title\" checked/>\r\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked/>\r\n        <input type=\"checkbox\" name=\"showIcon\" title=\"Icon\" checked/>\r\n        <input type=\"color\" name=\"icon\" title=\"Icon Color\" value=\"#000000\" condition=\"showIcon\"/>\r\n        <input type=\"checkbox\" name=\"showName\" title=\"Name\" checked/>\r\n        <input type=\"checkbox\" name=\"showRole\" title=\"Role\" checked/>\r\n        <input type=\"checkbox\" title=\"Image Overlay\" name=\"showImageOverlay\">\r\n        <input type=\"color\" title=\"Image Overlay Color\" value=\"#f3f6f9\" name=\"imageOver\" condition=\"showImageOverlay\"\r\n               selected>\r\n        <input type=\"range\" inline title=\"Overlay Opacity\" name=\"imageOverOpacity\" min=\"0\" max=\"1\" step=\"0.1\"\r\n               value=\"0.5\" condition=\"showImageOverlay\">\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected/>\r\n        </fieldset>\r\n        <input\r\n                type=\"checkbox\"\r\n                title=\"Overlay\"\r\n                name=\"overlay\"\r\n                condition=\"bg.type !== 'color'\"\r\n                checked\r\n        />\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.1\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12\">\r\n                <div\r\n                        class=\"embla\"\r\n                        data-loop=\"{{loop}}\"\r\n                        data-auto-play=\"{{autoplay}}\"\r\n                        data-auto-play-interval=\"{{interval}}\"\r\n                        data-draggable=\"{{draggable}}\"\r\n                        data-skip-snaps=\"true\"\r\n                        data-align=\"center\"\r\n                        data-contain-scroll=\"trimSnaps\"\r\n                >\r\n                    <div class=\"embla__viewport\">\r\n                        <div class=\"embla__container\">\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@PROJECT_PATH@/assets/images/background3.webp\" alt=\"Mobirise Website Builder\"/>\r\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                               mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\r\n                                                Labs\r\n                                            </p>\r\n                                            <div class=\"title-wrapper\">\r\n                                                <div class=\"title-wrap\">\r\n                                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                                        data-app-selector=\".item-title, .mbr-section-btn, .title-wrap\"\r\n                                                        mbr-if=\"showTitle\">\r\n                                                        <b>Research has been reshaping our understanding</b>\r\n                                                    </h4>\r\n                                                </div>\r\n                                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                                     mbr-if=\"showButtons\"\r\n                                                     data-toolbar=\"-mbrBtnMove\">\r\n                                                    <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\"\r\n                                                       data-app-placeholder=\"Type Text\">\r\n                                                        Read More\r\n                                                    </a>\r\n                                                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\"\r\n                                                       data-app-placeholder=\"Type Text\">\r\n                                                        Start Now\r\n                                                    </a>\r\n                                                </div>\r\n                                            </div>\r\n                                            <div class=\"name-wrapper\">\r\n                                                <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\">\r\n                                                        </span>\r\n                                                </div>\r\n                                                <div class=\"name-wrap\">\r\n                                                    <h4 class=\"item-name mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-7\"\r\n                                                        data-app-selector=\".item-name\"\r\n                                                        mbr-if=\"showName\">\r\n                                                        <b>Dr. Amelia Turner</b>\r\n                                                    </h4>\r\n                                                    <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                                       mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                        Quantum Physicist\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@PROJECT_PATH@/assets/images/background4.webp\" alt=\"Mobirise Website Builder\"/>\r\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                               mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\r\n                                                Labs\r\n                                            </p>\r\n                                            <div class=\"title-wrapper\">\r\n                                                <div class=\"title-wrap\">\r\n                                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                                        data-app-selector=\".item-title, .mbr-section-btn, .title-wrap\"\r\n                                                        mbr-if=\"showTitle\">\r\n                                                        <b>Trailblazing renewable energy scientist</b>\r\n                                                    </h4>\r\n                                                </div>\r\n                                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                                     mbr-if=\"showButtons\"\r\n                                                     data-toolbar=\"-mbrBtnMove\">\r\n                                                    <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\"\r\n                                                       data-app-placeholder=\"Type Text\">\r\n                                                        Read More\r\n                                                    </a>\r\n                                                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\"\r\n                                                       data-app-placeholder=\"Type Text\">\r\n                                                        Start Now\r\n                                                    </a>\r\n                                                </div>\r\n                                            </div>\r\n                                            <div class=\"name-wrapper\">\r\n                                                <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                        <span mbr-icon\r\n                                                              class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\"></span>\r\n                                                </div>\r\n                                                <div class=\"name-wrap\">\r\n                                                    <h4 class=\"item-name mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-7\"\r\n                                                        data-app-selector=\".item-name\"\r\n                                                        mbr-if=\"showName\">\r\n                                                        <b>Javier Morales</b>\r\n                                                    </h4>\r\n                                                    <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                                       mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                        Renewable Energy Innovator\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"embla__slide slider-image item\"\r\n                                 mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                <div class=\"slide-content\">\r\n                                    <div class=\"item-wrapper\">\r\n                                        <div class=\"item-img\">\r\n                                            <img src=\"@PROJECT_PATH@/assets/images/background2.webp\" alt=\"Mobirise Website Builder\"/>\r\n                                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                               mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\r\n                                                Labs\r\n                                            </p>\r\n                                            <div class=\"title-wrapper\">\r\n                                                <div class=\"title-wrap\">\r\n                                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-2\"\r\n                                                        data-app-selector=\".item-title, .mbr-section-btn\"\r\n                                                        mbr-if=\"showTitle\">\r\n                                                        <b>Marine biology lab committed to unraveling the mysteries</b>\r\n                                                    </h4>\r\n                                                </div>\r\n                                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\"\r\n                                                     mbr-if=\"showButtons\"\r\n                                                     data-toolbar=\"-mbrBtnMove\">\r\n                                                    <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\"\r\n                                                       data-app-placeholder=\"Type Text\">\r\n                                                        Read More\r\n                                                    </a>\r\n                                                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\"\r\n                                                       data-app-placeholder=\"Type Text\">\r\n                                                        Start Now\r\n                                                    </a>\r\n                                                </div>\r\n                                            </div>\r\n                                            <div class=\"name-wrapper\">\r\n                                                <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                                        <span mbr-icon\r\n                                                              class=\"mbr-iconfont mobi-mbri-user-2 mobi-mbri\"></span>\r\n                                                </div>\r\n                                                <div class=\"name-wrap\">\r\n                                                    <h4 class=\"item-name mbr-fonts-style\"\r\n                                                        mbr-theme-style=\"display-7\"\r\n                                                        data-app-selector=\".item-name\"\r\n                                                        mbr-if=\"showName\">\r\n                                                        <b>Dr. Marcus Rodriguez</b>\r\n                                                    </h4>\r\n                                                    <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\"\r\n                                                       mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\r\n                                                        Marine Biologist\r\n                                                    </p>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <button class=\"embla__button embla__button--prev\">\r\n                        <span class=\"mbr-iconfont mobi-mbri-left mobi-mbri\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\r\n                    </button>\r\n                    <button class=\"embla__button embla__button--next\">\r\n                        <span class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" aria-hidden=\"true\"></span>\r\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 30px",
                "@media (max-width: 768px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "height": "100%",
                  ".item-img": {
                    "position": "relative",
                    "min-height": "830px",
                    "border-radius": "20px !important",
                    "overflow": "hidden",
                    "padding": "60px 86px 80px",
                    "display": "flex",
                    "flex-direction": "column",
                    "justify-content": "space-between",
                    "@media (max-width: 992px)": {
                      "padding": "46px 20px 46px",
                      "min-height": "auto",
                      "height": "100%"
                    },
                    "img": {
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "border-radius": "20px !important",
                      "object-fit": "cover"
                    },
                    "& when (@showImageOverlay)": {
                      "&::before": {
                        "content": "''",
                        "position": "absolute",
                        "top": "0",
                        "left": "0",
                        "width": "100%",
                        "height": "100%",
                        "pointer-events": "none",
                        "z-index": "1",
                        "border-radius": "20px !important",
                        "background-color": "@imageOver",
                        "opacity": "@imageOverOpacity"
                      }
                    },
                    ".item-desc": {
                      "position": "relative",
                      "z-index": "1",
                      "margin-bottom": "32px"
                    },
                    ".title-wrapper": {
                      "position": "relative",
                      "z-index": "1",
                      "margin-bottom": "20px",
                      ".title-wrap": {
                        ".item-title": {
                          "display": "inline-flex",
                          "width": "60%",
                          "margin-bottom": "32px",
                          "@media (max-width: 768px)": {
                            "width": "100%"
                          }
                        }
                      }
                    },
                    ".name-wrapper": {
                      "position": "relative",
                      "z-index": "1",
                      "display": "inline-flex",
                      "align-items": "center",
                      "margin": "0 auto",
                      ".icon-wrapper": {
                        "margin-right": "32px",
                        "@media (max-width: 768px)": {
                          "margin-right": "16px"
                        },
                        ".mbr-iconfont": {
                          "font-size": "86px",
                          "border-radius": "100%",
                          "color": "@icon"
                        },
                        ".name-wrap": {
                          ".item-name": {
                            "margin-bottom": "16px"
                          },
                          ".item-role": {
                            "margin-bottom": "0"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "50%",
              "width": "48px",
              "height": "48px",
              "margin-top": "-1.5rem",
              "font-size": "18px",
              "background-color": "transparent !important",
              "color": "@primaryColor !important",
              "border": "2px solid @primaryColor !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": ".6 !important",
              "@media (max-width: 768px)": {
                "top": "2.5rem",
                "color": "@primaryColor !important",
                "border": "2px solid @primaryColor !important"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "opacity": "1 !important"
              },
              "&.embla__button--prev": {
                "left": "30px"
              },
              "&.embla__button--next": {
                "right": "30px"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "padding-top": "100px"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-desc": {
              "color": "#000000",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#000000"
            },
            ".item-name": {
              "color": "#000000"
            },
            ".item-role": {
              "color": "#000000"
            },
            ".list": {
              "color": "#000000"
            },
            ".item-title, .mbr-section-btn, .title-wrap": {
              "text-align": "center"
            }
          },
          "_cid": "v3RdLVbboK",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider03-ad"
        },
        {
          "_name": "features06",
          "_sourceTheme": "immersem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"features06 immersem5\"\r\n        group=\"Features\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\"/>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"12\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n                condition=\"fullScreen == false\"\r\n        />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked/>\r\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked/>\r\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked/>\r\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked/>\r\n        <input type=\"color\" title=\"Border Color\" value=\"#f3f6f9\" name=\"border\" condition=\"showButtons\" selected/>\r\n        <header>Cards</header>\r\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked/>\r\n        <input type=\"checkbox\" title=\"Card Number\" name=\"showNumber\" checked/>\r\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\" checked/>\r\n        <input type=\"color\" title=\"Icon Color\" value=\"#000000\" name=\"icon\" condition=\"showIcon\" selected/>\r\n        <input type=\"color\" title=\"Card BG\" value=\"#f3f6f9\" name=\"card\" selected/>\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected/>\r\n        </fieldset>\r\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\r\n        <input\r\n                type=\"image\"\r\n                title=\"Fallback Image\"\r\n                value=\"@PROJECT_PATH@/assets/images/background1.webp\"\r\n                name=\"fallBackImage\"\r\n                condition=\"bg.type === 'video'\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\"/>\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.8\"\r\n                condition=\"overlay && bg.type !== 'color'\"\r\n        />\r\n    </mbr-parameters>\r\n\r\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\r\n    <div\r\n            class=\"mbr-overlay\"\r\n            mbr-if=\"overlay && bg.type !== 'color'\"\r\n            opacity=\"{{overlayOpacity}}\"\r\n            bg-color=\"{{overlayColor}}\"\r\n    ></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12\">\r\n                <div class=\"content-wrapper\">\r\n                    <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                        data-app-selector=\".mbr-section-title, .mbr-section-btn, .image-wrapper\"\r\n                        mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                        <b>Joining a scientific community</b>\r\n                    </h2>\r\n                    <div class=\"desc-wrapper\">\r\n                        <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\"\r\n                           data-app-selector=\".mbr-desc, .desc-wrapper\">\r\n                            Rewarding experience that allows you to collaborate with like-minded individuals.\r\n                        </p>\r\n                    </div>\r\n                    <div class=\"items-wrapper\">\r\n                        <div class=\"item features-without-image item-mb\">\r\n                            <div class=\"item-wrapper\">\r\n                                <div class=\"card-box\">\r\n                                    <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                       data-app-selector=\".card-number\" mbr-if=\"showNumber\">\r\n                                        01\r\n                                    </p>\r\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                        data-app-selector=\".card-title, .icon-wrapper\" mbr-if=\"showCardTitle\">\r\n                                        <b>Identify</b>\r\n                                    </h4>\r\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-idea mobi-mbri\"></span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"item features-without-image item-mb\">\r\n                            <div class=\"item-wrapper\">\r\n                                <div class=\"card-box\">\r\n                                    <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                       data-app-selector=\".card-number\" mbr-if=\"showNumber\">\r\n                                        02\r\n                                    </p>\r\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                        data-app-selector=\".card-title, .icon-wrapper\" mbr-if=\"showCardTitle\">\r\n                                        <b>Research</b>\r\n                                    </h4>\r\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-search mobi-mbri\"></span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"item features-without-image item-mb\">\r\n                            <div class=\"item-wrapper\">\r\n                                <div class=\"card-box\">\r\n                                    <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                       data-app-selector=\".card-number\" mbr-if=\"showNumber\">\r\n                                        03\r\n                                    </p>\r\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                        data-app-selector=\".card-title, .icon-wrapper\" mbr-if=\"showCardTitle\">\r\n                                        <b>Attend</b>\r\n                                    </h4>\r\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-users mobi-mbri\"></span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"item features-without-image item-mb\">\r\n                            <div class=\"item-wrapper\">\r\n                                <div class=\"card-box\">\r\n                                    <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                       data-app-selector=\".card-number\" mbr-if=\"showNumber\">\r\n                                        04\r\n                                    </p>\r\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                        data-app-selector=\".card-title, .icon-wrapper\" mbr-if=\"showCardTitle\">\r\n                                        <b>Utilize</b>\r\n                                    </h4>\r\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-contact-form mobi-mbri\"></span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"item features-without-image item-mb\">\r\n                            <div class=\"item-wrapper\">\r\n                                <div class=\"card-box\">\r\n                                    <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-4\"\r\n                                       data-app-selector=\".card-number\" mbr-if=\"showNumber\">\r\n                                        05\r\n                                    </p>\r\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\"\r\n                                        data-app-selector=\".card-title, .icon-wrapper\" mbr-if=\"showCardTitle\">\r\n                                        <b>Engage</b>\r\n                                    </h4>\r\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\r\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-like mobi-mbri\"></span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"text-wrapper\">\r\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\"\r\n                           data-app-selector=\".mbr-text, .text-wrapper\">\r\n                            Remember, joining a scientific community is an ongoing process that requires dedication,\r\n                            active participation, and a genuine passion for the subject matter.\r\n                        </p>\r\n                    </div>\r\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"\r\n                         data-toolbar=\"-mbrBtnMove\">\r\n                        <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                            <span class=\"mobi-mbri mobi-mbri-link mbr-iconfont mbr-iconfont-btn\"></span>\r\n                            Start Now\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 30px",
                "@media (max-width: 768px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".content-wrapper": {
              "padding": "60px 0",
              "@media (max-width: 992px)": {
                "padding": "46px 0"
              },
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".desc-wrapper": {
                ".mbr-desc": {
                  "display": "inline-flex",
                  "width": "30%",
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              },
              ".items-wrapper": {
                "margin": "60px 0 80px",
                "display": "flex",
                "flex-wrap": "wrap",
                "justify-content": "center",
                "gap": "20px",
                "width": "100%",
                "@media (max-width: 992px)": {
                  "margin": "46px 0 46px"
                },
                ".item": {
                  "padding": "20px 24px",
                  "border-radius": "20px !important",
                  "background-color": "@card",
                  "flex-grow": "1",
                  "width": "260px",
                  "@media (max-width: 992px)": {
                    "padding": "20px"
                  },
                  ".item-wrapper": {
                    ".card-box": {
                      ".card-number": {
                        "margin-bottom": "18px"
                      },
                      ".card-title": {
                        "margin-bottom": "60px"
                      },
                      ".icon-wrapper": {
                        ".mbr-iconfont": {
                          "font-size": "48px",
                          "color": "@icon",
                          "display": "inline-flex"
                        }
                      }
                    }
                  }
                }
              },
              ".text-wrapper": {
                ".mbr-text": {
                  "display": "inline-flex",
                  "width": "40%",
                  "margin-bottom": "40px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px",
                    "width": "100%"
                  }
                }
              },
              ".mbr-section-btn": {
                ".btn-primary, .btn-secondary, .btn-success, .btn-info, .btn-warning, .btn-danger, .btn-black, .btn-white": {
                  "border": "2px solid @border !important"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-desc, .desc-wrapper": {
              "color": "#000000",
              "text-align": "center"
            },
            ".card-number": {
              "color": "#000000"
            },
            ".card-title": {
              "color": "#000000"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "center"
            }
          },
          "_cid": "v3Rb9hx2ZV",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "features06-ab"
        },
        {
          "_name": "slider05",
          "_sourceTheme": "immersem5",
          "_customHTML": "<section data-bs-version=\"5.1\"\r\n        class=\"slider05 mbr-embla\"\r\n        group=\"Sliders & Galleries\"\r\n        plugins=\"embla\"\r\n        mbr-class=\"{\r\n    'mbr-fullscreen': fullScreen,\r\n    'mbr-parallax-background': bg.parallax}\"\r\n>\r\n    <mbr-parameters>\r\n        <header>Size</header>\r\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked/>\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Top\"\r\n                name=\"paddingTop\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Bottom\"\r\n                name=\"paddingBottom\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <header>Show/Hide</header>\r\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked/>\r\n        <input type=\"checkbox\" name=\"showDesc\" title=\"Description\" checked/>\r\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked/>\r\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked/>\r\n        <header>Carousel</header>\r\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\"/>\r\n        <input\r\n                type=\"range\"\r\n                title=\"Interval\"\r\n                name=\"interval\"\r\n                min=\"1\"\r\n                max=\"10\"\r\n                value=\"5\"\r\n                step=\"1\"\r\n                condition=\"autoplay\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked/>\r\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked/>\r\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked/>\r\n        <input\r\n                type=\"checkbox\"\r\n                name=\"arrowsMobile\"\r\n                title=\"Mobile Arrows\"\r\n                condition=\"arrows\"\r\n        />\r\n        <header>Cards</header>\r\n        <input\r\n                type=\"range\"\r\n                name=\"gap\"\r\n                title=\"Gap\"\r\n                min=\"0\"\r\n                max=\"10\"\r\n                step=\"1\"\r\n                value=\"1\"\r\n        />\r\n        <input type=\"checkbox\" title=\"Image Overlay\" name=\"showImageOverlay\">\r\n        <input type=\"color\" title=\"Image Overlay Color\" value=\"#000000\" name=\"imageOver\" condition=\"showImageOverlay\"\r\n               selected>\r\n        <input type=\"range\" inline title=\"Overlay Opacity\" name=\"imageOverOpacity\" min=\"0\" max=\"1\" step=\"0.1\"\r\n               value=\"0.5\" condition=\"showImageOverlay\">\r\n        <header>Background</header>\r\n        <fieldset type=\"background\" name=\"bg\" parallax>\r\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\"/>\r\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected/>\r\n        </fieldset>\r\n        <input\r\n                type=\"checkbox\"\r\n                title=\"Overlay\"\r\n                name=\"overlay\"\r\n                condition=\"bg.type !== 'color'\"\r\n                checked\r\n        />\r\n        <input\r\n                type=\"color\"\r\n                title=\"Overlay Color\"\r\n                name=\"overlayColor\"\r\n                value=\"#ffffff\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n        <input\r\n                type=\"range\"\r\n                inline\r\n                title=\"Opacity\"\r\n                name=\"overlayOpacity\"\r\n                min=\"0\"\r\n                max=\"1\"\r\n                step=\"0.1\"\r\n                value=\"0.1\"\r\n                condition=\"overlay && bg.type == 'image'\"\r\n        />\r\n    </mbr-parameters>\r\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\r\n\r\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\r\n        <div class=\"row\">\r\n            <div class=\"col-12\">\r\n                <div class=\"content-wrapper\">\r\n                    <div class=\"content-wrap\">\r\n                        <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\"\r\n                           data-app-selector=\".mbr-desc\">\r\n                            Events\r\n                        </p>\r\n                        <div class=\"title-wrapper\">\r\n                            <h2 class=\"mbr-section-title mbr-fonts-style\"\r\n                                data-app-selector=\".mbr-section-title, .mbr-section-btn\"\r\n                                mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\r\n                                <b>Meetings are vital forums</b>\r\n                            </h2>\r\n                            <div class=\"text-wrapper\">\r\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\"\r\n                                   data-app-selector=\".mbr-text, .text-wrapper\">\r\n                                    Scientists, and experts converge to exchange ideas, share findings, and engage in\r\n                                    collaborative discussions\r\n                                </p>\r\n                            </div>\r\n                        </div>\r\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"\r\n                             data-toolbar=\"-mbrBtnMove\">\r\n                            <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\r\n                                See More\r\n                            </a>\r\n                        </div>\r\n                    </div>\r\n                    <div\r\n                            class=\"embla\"\r\n                            data-loop=\"{{loop}}\"\r\n                            data-auto-play=\"{{autoplay}}\"\r\n                            data-auto-play-interval=\"{{interval}}\"\r\n                            data-draggable=\"{{draggable}}\"\r\n                            data-skip-snaps=\"true\"\r\n                            data-align=\"center\"\r\n                            data-contain-scroll=\"trimSnaps\"\r\n                    >\r\n                        <div class=\"embla__viewport\">\r\n                            <div class=\"embla__container\">\r\n                                <div class=\"embla__slide slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"slide-content\">\r\n                                        <div class=\"item-wrapper\">\r\n                                            <div class=\"item-img\">\r\n                                                <img src=\"@PROJECT_PATH@/assets/images/image2.webp\"\r\n                                                     alt=\"Mobirise Website Builder\"/>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"embla__slide slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"slide-content\">\r\n                                        <div class=\"item-wrapper\">\r\n                                            <div class=\"item-img\">\r\n                                                <img src=\"@PROJECT_PATH@/assets/images/image8.webp\"\r\n                                                     alt=\"Mobirise Website Builder\"/>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"embla__slide slider-image item\"\r\n                                     mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\r\n                                    <div class=\"slide-content\">\r\n                                        <div class=\"item-wrapper\">\r\n                                            <div class=\"item-img\">\r\n                                                <img src=\"@PROJECT_PATH@/assets/images/image3.webp\"\r\n                                                     alt=\"Mobirise Website Builder\"/>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <button class=\"embla__button embla__button--prev\">\r\n                            <span class=\"mbr-iconfont mobi-mbri-left mobi-mbri\" aria-hidden=\"true\"></span>\r\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\r\n                        </button>\r\n                        <button class=\"embla__button embla__button--next\">\r\n                            <span class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" aria-hidden=\"true\"></span>\r\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\r\n                        </button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>\r\n",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 30px",
                "@media (max-width: 768px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".content-wrapper": {
              "position": "relative",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              ".content-wrap": {
                "position": "absolute",
                "top": "0",
                "width": "976px",
                "height": "100%",
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "space-between",
                "margin": "0 auto",
                "z-index": "1",
                "padding": "60px 20px",
                "@media (max-width: 1200px)": {
                  "width": "680px"
                },
                "@media (max-width: 992px)": {
                  "padding": "46px 20px",
                  "top": "auto",
                  "width": "100%",
                  "height": "auto"
                },
                ".mbr-desc": {
                  "margin-bottom": "32px"
                },
                ".title-wrapper": {
                  ".mbr-section-title": {
                    "margin-bottom": "20px"
                  },
                  ".text-wrapper": {
                    ".mbr-text": {
                      "display": "inline-flex",
                      "width": "40%",
                      "margin-bottom": "40px",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "20px",
                        "width": "100%"
                      }
                    }
                  }
                },
                ".mbr-section-btn": {
                  "margin-top": "20px"
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "976px",
              "max-width": "976px",
              "@media (max-width: 1200px)": {
                "min-width": "680px",
                "max-width": "680px"
              },
              "@media (max-width: 992px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  ".item-img": {
                    "position": "relative",
                    "& when (@showImageOverlay)": {
                      "&::before": {
                        "content": "''",
                        "position": "absolute",
                        "top": "0",
                        "left": "0",
                        "width": "100%",
                        "height": "100%",
                        "pointer-events": "none",
                        "z-index": "1",
                        "border-radius": "20px !important",
                        "background-color": "@imageOver",
                        "opacity": "@imageOverOpacity"
                      }
                    },
                    "img": {
                      "height": "830px",
                      "border-radius": "20px !important",
                      "object-fit": "cover",
                      "@media (max-width: 992px)": {
                        "height": "650px"
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "50%",
              "width": "48px",
              "height": "48px",
              "margin-top": "-1.5rem",
              "font-size": "18px",
              "background-color": "transparent !important",
              "color": "@infoColor !important",
              "border": "2px solid @infoColor !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": ".6 !important",
              "@media (max-width: 768px)": {
                "top": "2.5rem"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "opacity": "1 !important"
              },
              "&.embla__button--prev": {
                "left": "12%",
                "@media (max-width: 1550px)": {
                  "left": "30px"
                },
                "@media (max-width: 1300px)": {
                  "left": "16px"
                }
              },
              "&.embla__button--next": {
                "right": "12%",
                "@media (max-width: 1550px)": {
                  "right": "30px"
                },
                "@media (max-width: 1300px)": {
                  "right": "16px"
                }
              },
              "@media (max-width: 992px)": {
                "top": "2.5rem"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrowsMobile)": {
                "@media (max-width: 992px)": {
                  "padding-top": "100px"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "visible",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-desc": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "center"
            }
          },
          "_cid": "v3RdOI92nO",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "slider05-ae"
        },
        {
          "_name": "image01",
          "_sourceTheme": "merchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"image01 merchm5\" group=\"Image & Video\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Decoration\" name=\"showDecor\" checked>\n        <input type=\"color\" title=\"Decoration Color\" value=\"#4f6df5\" name=\"decor\" condition=\"showDecor\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/merchm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/merchm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/image14.webp\" alt=\"Mobirise\">\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 60px",
                "@media (max-width: 992px)": {
                  "padding": "0 23px"
                },
                "@media (max-width: 768px)": {
                  "padding": "0 12px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 23px"
              },
              "@media (max-width: 768px)": {
                "padding": "0 12px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".image-wrapper": {
              "position": "relative",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "padding": "0 12%",
              "& when (@showDecor)": {
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "left": "0",
                  "width": "100%",
                  "height": "50%",
                  "background-color": "@decor",
                  "border-radius": "32px",
                  "opacity": ".85"
                }
              },
              "img": {
                "height": "500px",
                "object-fit": "cover",
                "position": "relative",
                "@media (max-width: 992px)": {
                  "height": "350px"
                }
              }
            }
          },
          "_cid": "v3QYJBAzW3",
          "_anchor": "image01-a4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "features05",
          "_sourceTheme": "shapem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features05 shapem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#e4ed64\" name=\"label\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Image Decoration\" name=\"showDecor\" checked condition=\"bg.type === 'color'\">\n        <header>Rating</header>\n        <input type=\"checkbox\" title=\"Rating\" name=\"showRating\">\n        <input type=\"checkbox\" title=\"Rating Number\" name=\"showNumber\" condition=\"showRating\" checked>\n        <input type=\"checkbox\" title=\"Rating Title\" name=\"showRatingTitle\" condition=\"showRating\" checked>\n        <input type=\"range\" inline title=\"Star Count\" name=\"star\" min=\"1\" max=\"5\" step=\"1\" value=\"5\" condition=\"showRating\">\n        <input type=\"checkbox\" title=\"Rating Description\" name=\"showDesc\" condition=\"showRating\" checked>\n        <input type=\"color\" title=\"Rating Border Color\" value=\"#ffffff\" name=\"ratingBorder\" condition=\"showRating\" selected>\n        <input type=\"color\" title=\"Rating BG\" value=\"#000000\" name=\"cardBg\" selected>\n        <input type=\"range\" inline title=\"Bg Opacity\" name=\"cardOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" value=\"#000000\" name=\"icon\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Icon BG\" value=\"#e4ed64\" name=\"iconBg\" condition=\"showIcon\" selected>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Card Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#e0e0e0\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/shapem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/shapem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"card-wrapper\">\n                    <div class=\"image-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/image9.webp\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"decor-wrap\" mbr-if=\"showDecor\"></div>\n                    <div class=\"item-wrapper item-blur\" mbr-if=\"showRating\">\n                        <div class=\"card-box\">\n                            <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showNumber\" data-app-selector=\".item-number\">\n                                5.0\n                            </p>\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showRatingTitle\" data-app-selector=\".item-title\">\n                                <b>Building Contractors</b>\n                            </h4>\n                            <div class=\"rating-wrapper\">\n                                <div class=\"rating-wrap\">\n                                    <p class=\"item-star mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-star, .rating-wrapper\">\n                                        ★\n                                    </p>\n                                    <p class=\"item-star mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"star > 1\" data-app-selector=\".item-star, .rating-wrapper\">\n                                        ★\n                                    </p>\n                                    <p class=\"item-star mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"star > 2\" data-app-selector=\".item-star, .rating-wrapper\">\n                                        ★\n                                    </p>\n                                    <p class=\"item-star mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"star > 3\" data-app-selector=\".item-star, .rating-wrapper\">\n                                        ★\n                                    </p>\n                                    <p class=\"item-star mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"star > 4\" data-app-selector=\".item-star, .rating-wrapper\">\n                                        ★\n                                    </p>\n                                </div>\n                            </div>\n                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\n                                <b>Customer Evaluation</b>\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"content-wrapper\">\n                    <div class=\"label-wrapper\">\n                        <p class=\"mbr-label mbr-fonts-style\" data-app-selector=\".mbr-label, .label-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\">\n                            <b>Benefits</b>\n                        </p>\n                    </div>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>Benefits of Building Contractors</b>\n                    </h2>\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                        Building contractors oversee the entire construction process, coordinating all activities\n                        from planning to completion.\n                    </p>\n                    <div class=\"items-wrapper\">\n                        <div class=\"item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"card-box\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-like mobi-mbri\"></span>\n                                    </div>\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                                        <b>Skilled Tradespeople</b>\n                                    </h4>\n                                    <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">\n                                        Contractors have established networks of trusted subcontractors and laborers.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"card-box\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-like mobi-mbri\"></span>\n                                    </div>\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                                        <b>Compliance <br> with Codes</b>\n                                    </h4>\n                                    <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">\n                                        They ensure all work is done in accordance with local building codes, safety\n                                        standards.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"card-box\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-like mobi-mbri\"></span>\n                                    </div>\n                                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                                        <b>Efficient <br> Resource</b>\n                                    </h4>\n                                    <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">\n                                        Contractors know how to allocate labor, materials, and equipment efficiently.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-wrapper": {
              "position": "relative",
              "height": "100%",
              "margin-right": "48px",
              "will-change": "transform",
              "animation": "none !important",
              "@media (max-width: 992px)": {
                "margin-bottom": "60px",
                "margin-right": "0",
                "height": "auto"
              },
              "& when (@reverseContent)": {
                "margin-right": "0",
                "margin-left": "48px",
                "@media (max-width: 992px)": {
                  "margin-left": "0"
                }
              },
              ".image-wrap": {
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover",
                  "will-change": "transform",
                  "animation": "none !important",
                  "@media (max-width: 992px)": {
                    "position": "static",
                    "height": "400px"
                  }
                }
              },
              ".decor-wrap": {
                "position": "absolute",
                "top": "0",
                "right": "0",
                "width": "220px",
                "height": "60px",
                "background-color": "@bg-value",
                "border-bottom-left-radius": "30px",
                "z-index": "1",
                "@media (max-width: 992px)": {
                  "width": "120px"
                },
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "0",
                  "left": "-20px",
                  "width": "20px",
                  "height": "20px",
                  "background-color": "transparent",
                  "border-top-right-radius": "30px",
                  "box-shadow": "10px -10px 0 10px @bg-value"
                },
                "&::after": {
                  "content": "''",
                  "position": "absolute",
                  "top": "60px",
                  "right": "0",
                  "width": "20px",
                  "height": "20px",
                  "background-color": "transparent",
                  "border-top-right-radius": "30px",
                  "box-shadow": "10px -10px 0 10px @bg-value"
                }
              },
              ".item-wrapper": {
                "position": "absolute",
                "bottom": "-20px",
                "left": "30px",
                "width": "260px",
                "animation": "none !important",
                "backdrop-filter": "blur(10px)",
                "padding": "40px",
                "@media (max-width: 992px)": {
                  "padding": "30px",
                  "bottom": "-30px",
                  "left": "0"
                },
                "@media (max-width: 425px)": {
                  "width": "100%"
                },
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "border": "1px solid @ratingBorder",
                  "z-index": "1",
                  "pointer-events": "none",
                  "opacity": "@cardOpacity",
                  "background-color": "@cardBg"
                },
                ".card-box": {
                  "z-index": "2",
                  "position": "relative",
                  ".item-number": {
                    "margin-bottom": "15px"
                  },
                  ".item-title": {
                    "margin-bottom": "15px"
                  },
                  ".rating-wrapper": {
                    "margin-bottom": "5px",
                    ".rating-wrap": {
                      "display": "inline-flex",
                      ".item-star": {
                        "margin-bottom": "0",
                        "display": "inline-flex"
                      }
                    }
                  },
                  ".item-desc": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".content-wrapper": {
              ".label-wrapper": {
                ".mbr-label": {
                  "display": "inline-block",
                  "padding": "4px 20px",
                  "margin-bottom": "20px",
                  "border": "1px solid @label"
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "15px"
              },
              ".mbr-text": {
                "margin-bottom": "0"
              },
              ".items-wrapper": {
                "margin-top": "30px",
                ".item": {
                  "padding": "35px 0",
                  "@media (max-width: 992px)": {
                    "padding": "30px 0"
                  },
                  "&:last-child": {
                    "padding-bottom": "0 !important"
                  },
                  "& when (@showBorder)": {
                    "border-top": "1px solid @border"
                  },
                  ".item-wrapper": {
                    ".card-box": {
                      "display": "flex",
                      "align-items": "center",
                      "@media (max-width: 992px)": {
                        "display": "block"
                      },
                      ".iconfont-wrapper": {
                        "display": "inline-flex",
                        "margin-right": "30px",
                        "@media (max-width: 992px)": {
                          "margin-right": "0",
                          "margin-bottom": "20px"
                        },
                        ".mbr-iconfont": {
                          "width": "80px",
                          "height": "80px",
                          "min-width": "80px",
                          "display": "inline-flex",
                          "align-items": "center",
                          "justify-content": "center",
                          "font-size": "30px",
                          "color": "@icon",
                          "background-color": "@iconBg",
                          "border-radius": "100%"
                        }
                      },
                      ".card-title": {
                        "padding-right": "30px",
                        "width": "30%",
                        "margin-bottom": "0",
                        "@media (max-width: 992px)": {
                          "padding-right": "0",
                          "width": "100%",
                          "margin-bottom": "20px"
                        }
                      },
                      ".card-text": {
                        "padding-right": "30px",
                        "width": "50%",
                        "margin-bottom": "0",
                        "@media (max-width: 992px)": {
                          "padding-right": "0",
                          "width": "100%"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".mbr-label, .label-wrapper": {
              "color": "#000000"
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#8a8a8a"
            },
            ".card-title": {
              "color": "#000000"
            },
            ".card-text": {
              "color": "#8a8a8a"
            },
            ".item-number": {
              "color": "#e4ed64",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".item-star, .rating-wrapper": {
              "color": "#e4ed64",
              "text-align": "center"
            },
            ".item-desc": {
              "color": "#ffffff",
              "text-align": "center"
            }
          },
          "_cid": "v3QzLwpd7A",
          "_anchor": "features05-a1",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".item-img": {
              "position": "relative",
              "img": {
                "transition": "all 0.2s",
                "object-fit": "cover"
              }
            },
            ".cardbg": {
              "background": "@contentBg",
              "height": "100%",
              "min-height": "300px"
            },
            ".mbr-section-subtitle": {
              "border": "1px solid currentColor",
              "border-radius": "1rem",
              "width": "fit-content",
              "padding": "0.2rem 0.7rem",
              "display": "inline-block"
            },
            ".image-wrapper": {
              "overflow": "hidden"
            },
            ".item1": {
              "margin-bottom": "2rem !important"
            },
            ".item-wrapper": {
              "position": "relative",
              "background": "@cardsBg",
              "border": "3px solid @cardsBg",
              "overflow": "hidden",
              "height": "100%",
              "display": "flex",
              "flex-flow": "column nowrap",
              ".item-footer": {
                "margin-top": "auto"
              }
            },
            ".item-link": {
              "position": "absolute",
              "bottom": "8px",
              "right": "90px",
              "color": "#ffffff"
            },
            ".item1, .item": {
              "transition": "transform 0.3s",
              ".item": {
                "&:hover": {
                  "cursor": "pointer"
                }
              },
              "&:hover": {
                ".link-icon-wrapper span": {
                  "transform": "rotate(-20deg) scale(1.3)"
                }
              },
              "margin-bottom": "2rem"
            },
            ".card2": {
              "@media (max-width: 992px)": {
                "margin-top": "1rem"
              }
            },
            ".link-icon-wrapper": {
              "position": "absolute",
              "right": "-1px",
              "padding": "2px",
              "bottom": "-1px",
              "background": "@cardsBg",
              "width": "68px",
              "height": "68px",
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-end",
              "border-top-left-radius": "50%",
              "border-bottom-right-radius": "2rem",
              "z-index": "3",
              ".icon-wrap": {
                "background": "@iconBg",
                "width": "55px",
                "height": "55px",
                "transition": "all 0.3s",
                "display": "flex",
                "justify-content": "center",
                "align-items": "center",
                "border-radius": "50%",
                "span": {
                  "color": "@iconColor",
                  "font-size": "1.1rem",
                  "transition": "all 0.3s",
                  "display": "block",
                  "padding-top": "1px"
                }
              },
              ".svg1": {
                "position": "absolute",
                "top": "-29px",
                "right": "0px",
                "transform": "rotate(180deg)",
                "width": "30px",
                "path": {
                  "fill": "@cardsBg"
                }
              },
              ".svg2": {
                "position": "absolute",
                "transform": "rotate(180deg)",
                "width": "30px",
                "bottom": "0",
                "left": "-29px",
                "path": {
                  "fill": "@cardsBg"
                }
              }
            },
            ".item-content": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "margin-top": "1rem",
              "padding": "0 1.5rem 2rem",
              "@media (max-width: 767px)": {
                "padding": "0 1rem 1.4rem",
                "margin-top": "1rem"
              },
              "display": "flex",
              "flex-direction": "column",
              "height": "100%"
            },
            "img, .item-img": {
              "width": "100%"
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            "@media (max-width: 767px)": {
              ".item": {
                "margin-bottom": "1rem"
              }
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "left"
            },
            ".item-title": {
              "text-align": "left",
              "color": "#ffffff"
            },
            ".item-subtitle": {
              "text-align": "left",
              "color": "#ffffff"
            },
            ".mbr-section-subtitle, .subtitle-wrap, .mbr-section-btn": {
              "text-align": "left",
              "color": "#ffffff"
            },
            ".mbr-text, .item .mbr-section-btn": {
              "color": "#ffffff",
              "text-align": "left"
            }
          },
          "_name": "features5",
          "_sourceTheme": "ascentm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"ascentm5 features5\" group=\"Features\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n    <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n    <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n    <header>Cards</header>\n    <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked=\"\">\n    <input type=\"checkbox\" name=\"showCardSubtitle\" title=\"Subtitle\">\n    <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked=\"\">\n    <input type=\"checkbox\" name=\"showLink\" title=\"Link\">\n    <input type=\"color\" name=\"cardsBg\" title=\"Card BG\" value=\"#ffffff\">\n    <input type=\"color\" name=\"contentBg\" title=\"Content BG\" value=\"#4f6df5\">\n    <input type=\"color\" name=\"iconColor\" title=\"Icon Color\" value=\"#ffffff\">\n    <input type=\"color\" name=\"iconBg\" title=\"Icon BG\" value=\"#000000\">\n\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" required=\"\">\n      <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected=\"\">\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n  </mbr-parameters>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row justify-content-center\">\n      <div class=\"col-12 content-head\">\n        <div class=\"mbr-section-head mb-4\" mbr-if=\"showTitle || showSubtitle || showmainButton\">\n          <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>Why choose Crowd Attention Studio?</b></h4>\n\n        </div>\n      </div>\n    </div>\n\n    <div class=\"row\">\n      <div class=\"col-lg-7 col-md-12\">\n        <div class=\"item1 h-100 col-12 col-md-12 col-lg-12\">\n          <div class=\"item-wrapper h-100\">\n            <div class=\"item-img h-100\">\n              <div class=\"image-wrapper h-100\">\n                <img class=\"h-100\" src=\"@PROJECT_PATH@/assets/images/mbr-5-1920x1080.webp\" alt=\"Busy urban street with motion blur representing hyperlocal advertising and real-time data tracking for targeted marketing\">\n              </div>\n\n\n\n\n            </div>\n\n\n          </div>\n        </div>\n      </div>\n\n      <div class=\"col-lg-5 col-md-12\">\n        <div class=\"row h-100\">\n\n          <div class=\"item features-image h-100 col-12 col-md-12 col-lg-12 active\">\n            <div class=\"item-wrapper card2 h-100\">\n              <div class=\"item-img h-100\">\n                <div class=\"cardbg\">\n\n                </div>\n\n                <div class=\"link-icon-wrapper\">\n                  <svg class=\"svg1\" viewBox=\"0 0 100 100\">\n                    <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                  </svg>\n\n                  <div class=\"icon-wrap\">\n                    <a href=\"#\"><span mbr-icon=\"\" class=\"mbr-iconfont mbr-iconfont-btn mobi-mbri-right mobi-mbri\"></span></a>\n                  </div>\n\n                  <svg class=\"svg2\" viewBox=\"0 0 100 100\">\n                    <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                  </svg>\n\n                </div>\n\n                <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                  <div class=\"subtitle-wrap mb-3 w-100\">\n                    <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-3\" mbr-theme-style=\"display-7\" mbr-if=\"showCardSubtitle\" data-app-selector=\".mbr-section-subtitle, .subtitle-wrap, .mbr-section-btn\">The Blueprint</h5>\n                  </div>\n                  <h3 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>Hyperlocal Ads &amp; Multimodal</b></h3>\n\n                  <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .item .mbr-section-btn\">Connect with nearby customers or specific demographics, using highly targeted display ads and tracking tools to show exactly how people click and engage with your business.<br></p>\n                </div>\n                <h4 class=\"item-link mbr-fonts-style mt-3\" mbr-theme-style=\"display-7\" data-app-selector=\".item-link\" mbr-if=\"showLink\">\n                  <a href=\"#\" class=\"text-white\">Read more</a>\n                </h4>\n\n              </div>\n\n\n            </div>\n          </div>\n\n        </div>\n      </div>\n\n    </div>\n\n\n\n  </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "features5-a0",
          "_isUserblock": true,
          "_cid": "v3QyGXFAch",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "features03",
          "_sourceTheme": "shapem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 shapem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Image Decoration\" name=\"showDecor\" checked condition=\"bg.type === 'color'\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#e0e0e0\" name=\"border\" condition=\"showCardTitle\" selected>\n        <input type=\"checkbox\" title=\"Card Number\" name=\"showNumber\" checked>\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" checked>\n        <input type=\"color\" title=\"Card BG\" value=\"#f5f5f5\" name=\"cardBg\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/shapem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/shapem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>Delivering Quality Construction On Time, Every Time</b>\n                    </h2>\n                </div>\n            </div>\n        </div>\n        <div class=\"row items-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-6 card\">\n                <div class=\"card-wrapper\">\n                    <div class=\"image-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/image12.webp\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"decor-wrap\" mbr-if=\"showDecor\"></div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 card\">\n                <div class=\"items-wrap\">\n                    <div class=\"item features-without-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                                    <b>ON-TIME PROJECT</b>\n                                </h4>\n                                <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showNumber\" data-app-selector=\".card-number\">\n                                    <b>98%</b>\n                                </p>\n                                <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".card-desc\">\n                                    successfully delivered\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-without-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                                    <b>COST SAVINGS</b>\n                                </h4>\n                                <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showNumber\" data-app-selector=\".card-number\">\n                                    <b>25%</b>\n                                </p>\n                                <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".card-desc\">\n                                    implemented efficient\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-without-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                                    <b>RESIDENTIAL &amp; COMMERCIAL</b>\n                                </h4>\n                                <p class=\"card-number mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showNumber\" data-app-selector=\".card-number\">\n                                    <b>300+</b>\n                                </p>\n                                <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".card-desc\">\n                                    built a strong track\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/image19.webp\" alt=\"Mobirise Website Builder\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "50px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "30px"
                }
              }
            },
            ".items-wrapper": {
              "margin": "0 -15px",
              ".card": {
                "padding": "0 15px"
              }
            },
            ".card-wrapper": {
              "position": "relative",
              "height": "100%",
              "will-change": "transform",
              "animation": "none !important",
              "@media (max-width: 992px)": {
                "margin-bottom": "15px"
              },
              ".image-wrap": {
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover",
                  "will-change": "transform",
                  "animation": "none !important",
                  "@media (max-width: 992px)": {
                    "position": "static",
                    "height": "300px"
                  }
                }
              },
              ".decor-wrap": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "220px",
                "height": "60px",
                "background-color": "@bg-value",
                "border-bottom-right-radius": "30px",
                "z-index": "1",
                "@media (max-width: 992px)": {
                  "width": "120px"
                },
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "0",
                  "right": "-20px",
                  "width": "20px",
                  "height": "20px",
                  "background-color": "transparent",
                  "border-top-left-radius": "30px",
                  "box-shadow": "-10px -10px 0 10px @bg-value"
                },
                "&::after": {
                  "content": "''",
                  "position": "absolute",
                  "top": "60px",
                  "left": "0",
                  "width": "20px",
                  "height": "20px",
                  "background-color": "transparent",
                  "border-top-left-radius": "30px",
                  "box-shadow": "-10px -10px 0 10px @bg-value"
                }
              }
            },
            ".items-wrap": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "gap": "30px",
              "@media (max-width: 1200px)": {
                "display": "block"
              },
              ".item": {
                "@media (max-width: 1200px)": {
                  "margin-bottom": "30px",
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                },
                "@media (max-width: 992px)": {
                  "margin-bottom": "15px"
                },
                ".item-wrapper": {
                  "height": "100%",
                  "padding": "40px",
                  "background-color": "@cardBg",
                  "@media (max-width: 992px)": {
                    "padding": "30px"
                  },
                  ".card-box": {
                    ".card-title": {
                      "margin-bottom": "140px",
                      "padding-bottom": "15px",
                      "border-bottom": "1px solid @border",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "30px"
                      }
                    },
                    ".card-number": {
                      "margin-bottom": "0"
                    },
                    ".card-desc": {
                      "margin-bottom": "0"
                    }
                  }
                }
              },
              ".features-image": {
                ".item-wrapper": {
                  "padding": "0",
                  "background-color": "transparent",
                  ".item-img": {
                    "height": "100%",
                    "img": {
                      "width": "100%",
                      "height": "100%",
                      "object-fit": "cover",
                      "@media (max-width: 992px)": {
                        "height": "300px"
                      }
                    }
                  }
                }
              }
            },
            ".btn-wrapper": {
              "margin-top": "35%"
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".card-title": {
              "color": "#000000"
            },
            ".card-number": {
              "color": "#000000"
            },
            ".card-desc": {
              "color": "#8a8a8a"
            }
          },
          "_cid": "v3QAoTMxtM",
          "_anchor": "features03-a2",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "avideo1",
          "_sourceTheme": "expertm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"video1 expertm5\" group=\"Image & Video\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\"\n    mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"PlayerVimeo\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" >Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <input type=\"range\" inline title=\"Content Width\" name=\"contentWidth\" min=\"6\" max=\"12\" step=\"1\" value=\"11\">\n        <header>Video</header>\n        <input type=\"text\" title=\"Link\" name=\"modalVideo\" value=\"https://www.youtube.com/watch?v=VA8PzkQa8d8\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text 1\" name=\"showText1\" checked>\n        <input type=\"checkbox\" title=\"Text 2\" name=\"showText2\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Card Style</header>\n        <input type=\"color\" title=\"Card BG 1\" name=\"cardBg1\" value=\"#1e2024\">\n        <input type=\"color\" title=\"Card BG 2\" name=\"cardBg2\" value=\"#23272b\">\n        <input type=\"checkbox\" name=\"cardShadow\" title=\"Card Shadow\" checked>\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"shadowColor1\" value=\"#191b1f\" condition=\"cardShadow\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"shadowColor2\" value=\"#23272B\" condition=\"cardShadow\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#212428\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#212428\"\n            condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\"\n            condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\"\n        mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row card-row {{contentAlign}}\">\n            <div class=\"item-card col-12 d-flex col-lg-{{contentWidth}}\">\n                <div class=\"item-wrap\">\n                    <div class=\"row video-row\">\n                        <div class=\"col-12\">\n                            <div class=\"box\">\n                                <div class=\"mbr-media show-modal align-center\" data-modal=\".modalWindow\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/gallery5.webp\" alt=\"Mobirise Website Builder\">\n                                    <div class=\"icon-wrap\">\n                                        <a class=\"text-primary\">\n                                            <span mbr-icon class=\"mbr-iconfont socicon-youtube socicon\"\n                                                  style=\"color: #FF014E; font-size: 70px\">\n                                            </span>\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"row text-row align-items-center\" mbr-if=\"showTitle || showText1 || showText2 || showSubtitle || showButtons\">\n                        <div class=\"col-12 col-lg-9 flex-grow-1\" mbr-if=\"showTitle || showText1 || showText2 || showSubtitle\">\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"\n                                data-app-selector=\".card-title\">\n                                Nascetur ridiculus mus mauris vitae ultricies leo integer\n                            </h5>\n                            <h5 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\"\n                                data-app-selector=\".card-subtitle\">\n                                Lorem donec massa sapien faucibus et molestie.\n                            </h5>\n                            <div class=\"card-text-container\" mbr-if=\"showText1 || showText2\">\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText1\"\n                                   data-app-selector=\".card-text\">\n                                    <b>Client:</b> Scelerisque purus\n                                </p>\n                                <p class=\"card-text card-text-2 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText2\"\n                                   data-app-selector=\".card-text\">\n                                    <b>Date:</b> 24 august 2022\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-3 flex-grow-1\" mbr-if=\"showButtons\">\n                            <div mbr-buttons mbr-theme-style=\"display-7\"\n                                 class=\"mbr-section-btn custom-section-btn\" mbr-if=\"showButtons\">\n                                <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                    <span class=\"mobi-mbri mobi-mbri-like mbr-iconfont mbr-iconfont-btn\"></span>\n                                    LIKE THIS\n                                </a>\n                                <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                    <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                    VIEW PROJECT\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div>\n        <div class=\"modalWindow\" style=\"display: none;\">\n            <div class=\"modalWindow-container\">\n                <div class=\"modalWindow-video-container\">\n                    <div class=\"modalWindow-video\">\n                        <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\"\n                                allowfullscreen=\"1\"></iframe>\n                    </div>\n                    <a class=\"close\" role=\"button\" data-dismiss=\"modal\" data-bs-dismiss=\"modal\">\n                        <span aria-hidden=\"true\" class=\"mbr-iconfont mobi-mbri-close mobi-mbri closeModal\"></span>\n                        <span class=\"sr-only visually-hidden\">Close</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "background-attachment": "fixed",
              "background-repeat": "no-repeat",
              "background-size": "cover",
              "background-position": "center center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
