                },
                ".mbr-desc": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".mbr-section-title": {
                  "width": "100%",
                  "margin-bottom": "24px"
                },
                ".mbr-text": {
                  "width": "100%",
                  "margin-bottom": "0"
                },
                ".mbr-section-btn": {
                  "width": "100%",
                  "margin-top": "16px",
                  ".btn": {
                    "&::before": {
                      "background-image": "linear-gradient(90deg, @active_2 0%, transparent 100%)"
                    },
                    "&:hover, &:focus": {
                      "box-shadow": "inset 250px 10px 5px @active_1 !important",
                      "border-color": "@active_1 !important"
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#141414"
            },
            ".mbr-desc": {
              "color": "#141414"
            },
            ".mbr-text": {
              "color": "#141414"
            }
          },
