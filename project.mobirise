                "width": "55px",
                "height": "55px",
                "transition": "all 0.3s",
                "display": "flex",
                "justify-content": "center",
                "align-items": "center",
                "border-radius": "50%",
                "span": {
                  "color": "@iconColor",
                  "font-size": "1.1rem",
                  "transition": "all 0.3s",
